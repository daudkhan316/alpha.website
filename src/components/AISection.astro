---
const capabilities = [
  {
    title: 'Natural language → QL',
    body: 'Plain-English (or German) questions translate to QL — the declarative JSON query language — via Azure OpenAI GPT-4o.',
  },
  {
    title: 'Grounded by RAG',
    body: 'A curated knowledge base of entity docs, attribute docs, domain concepts and synonyms. The AI answers from your schema, not hallucination.',
  },
  {
    title: 'Query templates & rules',
    body: 'Reusable templates and a business-rule library steer the model toward correct, sanctioned answers — every time.',
  },
  {
    title: 'RLHF training pipeline',
    body: 'Every accepted/rejected answer feeds back. Visual workbench tabs for schema coverage, concepts, templates, rules and training.',
  },
];
---

{/* Override .section's `overflow-x: clip` — clip creates a clipping
    containing block that breaks `position: sticky` on descendants in
    Chromium. Body already has `overflow-x: hidden` at the page level,
    so dropping the section-level clip can't push horizontal scroll. */}
<section id="ai" class="section !overflow-x-visible">
  <div class="absolute inset-0 -z-10 bg-grid opacity-25 mask-fade-bottom"></div>
  <div class="blob blob-pink w-[520px] h-[520px] top-1/4 -left-40 opacity-50"></div>

  {/* `lg:items-start` instead of items-center so the sticky right panel
      has room to stick (a centered grid item has no extra height inside
      the row to stick within). The grid row's height is set by the
      taller column — the spaced-out capability list below — and the
      sticky inside the right column scrolls within that. */}
  <div class="container-wide grid lg:grid-cols-[1fr_1.1fr] gap-14 lg:items-start min-w-0">
    {/* Left: copy */}
    <div class="reveal">
      <div class="badge mb-6">
        <span class="font-mono text-[10px]" data-i18n="ai.badge">CB · COGNITIVE BACKEND</span>
      </div>
      <h2 class="section-heading">
        <span data-i18n="ai.heading.a">Ask in plain language.</span> <br />
        <span class="gradient-text" data-i18n="ai.heading.b">Get audited data.</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed max-w-lg" data-i18n="ai.body">
        The Cognitive Backend turns business questions into validated QL queries — grounded in your schema,
        gated by your permissions, traceable in your audit log.
      </p>

      {/* Capability list. On lg+ each capability is spaced ~28vh apart so
          one at a time fills the central viewport band, while the right-
          side terminal panel stays sticky throughout. As the user
          scrolls, the IntersectionObserver in Layout.astro marks
          whichever step crosses the central band as `.is-focused` — that
          one brightens, the others dim. Apple's product pages use this
          pattern: scroll = navigate features, visual stays anchored.

          On mobile (no lg), the spacing collapses back to the original
          tight rhythm (space-y-5) and the sticky behavior turns off via
          the lg: prefix on the wrapper below — so phone visitors don't
          have to scroll through dead space to read four bullets. */}
      <ul class="mt-10 space-y-5 lg:space-y-[28vh] max-w-lg" data-cap-list>
        {capabilities.map((c, i) => (
          <li class="ai-cap-step flex gap-3" data-cap-step={i}>
            <span class="mt-1 w-1.5 h-1.5 rounded-full bg-alpha-pink shadow-glow-pink shrink-0"></span>
            <div>
              <div class="font-medium text-white" data-i18n={`ai.cap.${i}.title`}>{c.title}</div>
              <div class="text-sm text-white/60 mt-1 leading-relaxed" data-i18n={`ai.cap.${i}.body`}>{c.body}</div>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-10 lg:mt-[20vh] flex items-center gap-3 text-xs text-white/55 font-mono uppercase tracking-wider">
        <span data-i18n="ai.poweredBy">Powered by</span>
        <span class="px-2 py-1 rounded-md bg-white/[0.04] border border-white/10 text-white/70" data-i18n="ai.gpt">Azure OpenAI · GPT-4o</span>
        <span class="px-2 py-1 rounded-md bg-white/[0.04] border border-white/10 text-white/70" data-i18n="ai.region">Germany WC</span>
      </div>
    </div>

    {/* Right: demo. The inner wrapper goes sticky on lg+ — `top-28`
        clears the fixed nav. The terminal stays parked centered-ish in
        the viewport for the whole length of the spaced-out left column
        below, so the demo keeps "running" while the user reads each
        capability in turn. On smaller viewports the sticky drops off
        and the panel sits in normal flow under the text, as before. */}
    <div class="relative reveal min-w-0 lg:sticky lg:top-28 lg:self-start">
      {/* Plain-language gloss for non-technical readers — the JSON below
          is illustrative, but the value lives in the sentence above it. */}
      <p class="relative text-sm text-white/70 max-w-md mb-5 leading-relaxed" data-i18n="ai.gloss">
        A business user types a question in plain English or German.
        The platform writes the query, runs it against audited data,
        and returns the answer — respecting the same permissions and
        leaving the same audit trail.
      </p>
      <div class="absolute -inset-8 bg-alpha-gradient-soft blur-3xl opacity-60 rounded-[40px]"></div>
      <div class="glass-strong relative rounded-[24px] overflow-hidden shadow-glow-purple min-w-0">
        {/* Terminal header */}
        <div class="flex items-center justify-between px-5 py-3 border-b border-white/5">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-300/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-300/80"></span>
          </div>
          <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-white/55" data-i18n="ai.terminal.title">cb · workbench</span>
          <span class="font-mono text-[10px] text-white/55">v3.5</span>
        </div>

        {/* Prompt */}
        <div class="px-5 py-5 border-b border-white/5">
          <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-white/60 mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-alpha-violet shadow-glow-violet"></span>
            <span data-i18n="ai.terminal.you">you</span>
          </div>
          <div class="text-white/95 text-sm sm:text-base leading-relaxed min-h-[3.5rem] break-words">
            <span data-ai-prompt></span><span class="inline-block w-[2px] h-[1.05em] align-[-2px] bg-alpha-pink animate-caret-blink ml-0.5"></span>
          </div>
        </div>

        {/* QL output */}
        <div class="px-5 py-5 border-b border-white/5">
          <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-white/60 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-alpha-pink shadow-glow-pink"></span>
            <span data-i18n="ai.terminal.cb">cognitive backend → ql</span>
          </div>
          <pre
            class="font-mono text-[10.5px] sm:text-xs leading-relaxed text-white/80 whitespace-pre overflow-x-auto min-h-[10.5rem]"
            data-ai-ql
          ></pre>
        </div>

        {/* Result */}
        <div class="px-5 py-5">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-white/60">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span>
              {/* The header reflects the current demo's row count + a small
                  jittered ms reading so it doesn't lie when demo #2 returns
                  a single row. The runtime updates `data-ai-result-meta`
                  on each cycle. */}
              <span data-ai-result-meta data-i18n="ai.terminal.result">result · 4 rows · 312 ms</span>
            </div>
            <span class="text-[10px] text-white/55 font-mono" data-i18n="ai.terminal.audit">audit · logged</span>
          </div>
          <div data-ai-result class="space-y-1.5 min-h-[10rem]"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Demo = {
    prompt: string;
    ql: string;
    result: { label: string; value: string; bar: number }[];
  };

  const demosEn: Demo[] = [
    {
      prompt: 'Show me total billed premium for Q1 broken down by product line.',
      ql: `{
  "select": ["product.line", "sum(billing.amount) as total"],
  "from":   "BillingItem",
  "filter": [
    { "field": "billing.period", "op": "eq",
      "value": "Q1-2026" }
  ],
  "groupBy": ["product.line"],
  "orderBy": [{ "field": "total", "dir": "desc" }]
}`,
      result: [
        { label: 'Auto',     value: '€ 2,418,950', bar: 100 },
        { label: 'Home',     value: '€ 1,734,220', bar: 72 },
        { label: 'Health',   value: '€ 1,052,810', bar: 44 },
        { label: 'Liability',value: '€   681,400', bar: 28 },
      ],
    },
    {
      prompt: 'How many active contracts does customer Müller hold today?',
      ql: `{
  "select": ["count(*) as active"],
  "from":   "Contract",
  "filter": [
    { "field": "customer.lastName", "op": "eq",
      "value": "Müller" },
    { "field": "status", "op": "eq", "value": "ACTIVE" }
  ]
}`,
      result: [
        { label: 'Müller, Anna · 80331 München', value: '4 contracts', bar: 100 },
      ],
    },
    {
      prompt: 'List unpaid invoices from the last dunning run, oldest first.',
      ql: `{
  "select": ["invoice.id", "customer.name", "amount.due",
             "dunning.level", "due.date"],
  "from":   "Invoice",
  "filter": [
    { "field": "payment.status", "op": "eq",
      "value": "UNPAID" },
    { "field": "dunning.runId", "op": "eq",
      "value": "@latest" }
  ],
  "orderBy": [{ "field": "due.date", "dir": "asc" }]
}`,
      result: [
        { label: 'INV-2026-00831 · Schmidt GmbH · L3', value: '€ 1,240.00', bar: 100 },
        { label: 'INV-2026-00714 · K. Weber · L2',     value: '€   612.50', bar: 56 },
        { label: 'INV-2026-00692 · F. Bauer · L2',     value: '€   348.20', bar: 32 },
        { label: 'INV-2026-00541 · M. Vogel · L1',     value: '€   210.00', bar: 20 },
      ],
    },
  ];

  // German prompts + result labels (machine draft — needs translator pass).
  // The QL JSON itself is in English because QL keys/operators are English in the real product.
  const demosDe: Demo[] = [
    {
      prompt: 'Zeig mir die gesamte gebuchte Prämie für Q1, aufgeschlüsselt nach Produktlinie.',
      ql: demosEn[0].ql,
      result: [
        { label: 'Kfz',         value: '€ 2.418.950', bar: 100 },
        { label: 'Wohngebäude', value: '€ 1.734.220', bar: 72 },
        { label: 'Kranken',     value: '€ 1.052.810', bar: 44 },
        { label: 'Haftpflicht', value: '€   681.400', bar: 28 },
      ],
    },
    {
      prompt: 'Wie viele aktive Verträge hat Kunde Müller heute?',
      ql: demosEn[1].ql,
      result: [
        { label: 'Müller, Anna · 80331 München', value: '4 Verträge', bar: 100 },
      ],
    },
    {
      prompt: 'Liste offene Rechnungen aus dem letzten Mahnlauf, älteste zuerst.',
      ql: demosEn[2].ql,
      result: [
        { label: 'INV-2026-00831 · Schmidt GmbH · M3', value: '€ 1.240,00', bar: 100 },
        { label: 'INV-2026-00714 · K. Weber · M2',     value: '€   612,50', bar: 56 },
        { label: 'INV-2026-00692 · F. Bauer · M2',     value: '€   348,20', bar: 32 },
        { label: 'INV-2026-00541 · M. Vogel · M1',     value: '€   210,00', bar: 20 },
      ],
    },
  ];

  const pickDemos = (): Demo[] =>
    document.documentElement.getAttribute('data-locale') === 'de' ? demosDe : demosEn;
  let demos = pickDemos();

  const promptEl = document.querySelector<HTMLElement>('[data-ai-prompt]');
  const qlEl = document.querySelector<HTMLElement>('[data-ai-ql]');
  const resEl = document.querySelector<HTMLElement>('[data-ai-result]');
  const metaEl = document.querySelector<HTMLElement>('[data-ai-result-meta]');
  // Reduced-motion users get a single static demo painted once — no
  // typewriter, no looped cycling. The same data drives both modes;
  // only the presentation differs.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Off-screen pause: we only run the demo while the section is in the
  // viewport. After scrolling past it, the loop suspends instead of
  // typing into an invisible terminal forever.
  let isVisible = false;
  if (promptEl && qlEl && resEl) {
    let demoIdx = 0;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const interruptibleSleep = async (ms: number) => {
      // Pause-aware sleep: yields control if visibility flips off.
      const start = performance.now();
      while (performance.now() - start < ms) {
        await sleep(Math.min(ms - (performance.now() - start), 80));
        if (!isVisible) {
          // Wait until visible again before continuing.
          await new Promise<void>((r) => {
            const tick = () => isVisible ? r() : setTimeout(tick, 200);
            tick();
          });
        }
      }
    };
    const setMeta = (rows: number) => {
      if (!metaEl) return;
      // Vary ms a tiny bit per demo so the indicator feels alive without
      // straying from "snappy backend response" range.
      const ms = 240 + Math.floor(Math.random() * 220);
      const word = rows === 1 ? 'row' : 'rows';
      metaEl.textContent = `result · ${rows} ${word} · ${ms} ms`;
      // Drop the i18n key once we override; locale change re-renders via
      // runDemo() which calls setMeta again with the active demo.
      metaEl.removeAttribute('data-i18n');
    };

    // rAF-paced typewriter. The previous setTimeout-per-char loop kept
    // queuing callbacks while the tab was backgrounded — when the tab
    // returned, all the pending sleeps resolved in quick succession and
    // the typewriter dumped multiple characters per frame. rAF callbacks
    // don't fire while the tab is hidden, so there's no buildup. The
    // catch-up cap (`if t - lastT > 200`) handles the small staleness
    // when rAF first resumes after un-hide: snap forward instead of
    // burning through accumulated delay budget.
    function typeInto(el: HTMLElement, text: string, delay: number): Promise<void> {
      return new Promise((resolve) => {
        el.textContent = '';
        let i = 0;
        let lastT = 0;
        const tick = (t: number) => {
          if (!lastT) lastT = t;
          if (t - lastT > 200) lastT = t - delay;
          while (t - lastT >= delay && i < text.length) {
            el.textContent += text[i];
            i++;
            lastT += delay;
          }
          if (i < text.length) {
            requestAnimationFrame(tick);
          } else {
            resolve();
          }
        };
        requestAnimationFrame(tick);
      });
    }

    function showThinking() {
      resEl!.innerHTML = '<div class="flex items-center gap-1.5 py-2"><span class="ai-think-dot"></span><span class="ai-think-dot"></span><span class="ai-think-dot"></span></div>';
    }

    function paintResult(rows: Demo['result']) {
      resEl!.innerHTML = '';
      const startCls = reducedMotion
        ? 'grid grid-cols-[1fr_auto] items-center gap-4'
        : 'opacity-0 translate-y-1 transition-all duration-500 grid grid-cols-[1fr_auto] items-center gap-4';
      rows.forEach((r, idx) => {
        const row = document.createElement('div');
        row.className = startCls;
        row.innerHTML = `
          <div class="space-y-1">
            <div class="text-[13px] text-white/85">${r.label}</div>
            <div class="h-1 rounded-full bg-white/[0.05] overflow-hidden">
              <div class="h-full rounded-full" style="width:${r.bar}%; background: linear-gradient(90deg,#667eea,#f093fb)"></div>
            </div>
          </div>
          <div class="font-mono text-xs text-white/85 tabular-nums">${r.value}</div>
        `;
        resEl!.appendChild(row);
        if (!reducedMotion) {
          setTimeout(() => {
            row.classList.remove('opacity-0', 'translate-y-1');
            row.classList.add('opacity-100', 'translate-y-0');
          }, 80 + idx * 90);
        }
      });
    }

    // Re-select demo set when the locale changes mid-cycle.
    window.addEventListener('alpha:locale-changed', () => {
      demos = pickDemos();
      demoIdx = 0;
    });

    function paintStatic(d: Demo) {
      // Reduced-motion variant: render the demo as a finished snapshot,
      // no typing, no streaming. Same data, no animation.
      promptEl!.textContent = d.prompt;
      qlEl!.textContent = d.ql;
      resEl!.innerHTML = '';
      d.result.forEach((r) => {
        const row = document.createElement('div');
        row.className = 'grid grid-cols-[1fr_auto] items-center gap-4';
        row.innerHTML = `
          <div class="space-y-1">
            <div class="text-[13px] text-white/85">${r.label}</div>
            <div class="h-1 rounded-full bg-white/[0.05] overflow-hidden">
              <div class="h-full rounded-full" style="width:${r.bar}%; background: linear-gradient(90deg,#667eea,#f093fb)"></div>
            </div>
          </div>
          <div class="font-mono text-xs text-white/85 tabular-nums">${r.value}</div>
        `;
        resEl!.appendChild(row);
      });
      setMeta(d.result.length);
    }

    async function runDemo() {
      while (true) {
        // Reset and re-pick the locale-correct demo set on each cycle.
        demos = pickDemos();
        qlEl!.textContent = '';
        resEl!.innerHTML = '';
        const d = demos[demoIdx];
        setMeta(d.result.length);
        // Type prompt
        await typeInto(promptEl!, d.prompt, 22);
        await interruptibleSleep(420);
        // Type QL
        await typeInto(qlEl!, d.ql, 6);
        // Show thinking dots before results stream in — gives the demo a
        // "system is computing" beat instead of jumping QL → answer in
        // one frame. 600ms is long enough to read but short enough to not
        // feel laggy on the third or fourth loop.
        await interruptibleSleep(140);
        showThinking();
        await interruptibleSleep(600);
        // Paint result (clears the thinking dots)
        paintResult(d.result);
        await interruptibleSleep(5400);
        demoIdx = (demoIdx + 1) % demos.length;
      }
    }

    // Only start when user nears the section. The IntersectionObserver
    // also keeps `isVisible` updated so the demo loop pauses when the
    // section scrolls out of view (instead of typing into an invisible
    // terminal forever and stealing main-thread time).
    const trigger = document.querySelector('#ai');
    if (reducedMotion) {
      // Static snapshot — no loop, no observer needed.
      paintStatic(demos[0]);
    } else if (trigger) {
      let started = false;
      const io = new IntersectionObserver((entries) => {
        const e = entries[0];
        isVisible = !!e?.isIntersecting;
        if (isVisible && !started) {
          started = true;
          runDemo();
        }
      }, { threshold: 0.15 });
      io.observe(trigger);
    } else {
      isVisible = true;
      runDemo();
    }
  }
</script>
