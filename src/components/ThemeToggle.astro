---
// Theme toggle: button cycles between dark and light, persists to localStorage.
// Initial state is set inline in Layout.astro <head> to avoid flash.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  aria-pressed="false"
  title="Toggle color theme"
  class="relative inline-grid place-items-center w-11 h-11 rounded-full transition-colors"
  style="background: var(--surface-strong); border: 1px solid var(--border-3);"
>
  {/* Sun (visible in dark mode → switch to light) */}
  <svg
    data-theme-icon="sun"
    width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
    class="absolute transition-all duration-300"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
  </svg>

  {/* Moon (visible in light mode → switch to dark) */}
  <svg
    data-theme-icon="moon"
    width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
    class="absolute transition-all duration-300"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
  </svg>
</button>

<style>
  /* Crossfade icons based on the active theme. */
  [data-theme-toggle] [data-theme-icon='sun']  { opacity: 1; transform: rotate(0deg) scale(1); }
  [data-theme-toggle] [data-theme-icon='moon'] { opacity: 0; transform: rotate(-90deg) scale(0.6); }

  :root[data-theme='light'] [data-theme-toggle] [data-theme-icon='sun']  { opacity: 0; transform: rotate(90deg) scale(0.6); }
  :root[data-theme='light'] [data-theme-toggle] [data-theme-icon='moon'] { opacity: 1; transform: rotate(0deg) scale(1); }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  // aria-pressed reflects "currently in light mode" (i.e. the moon button
  // is "engaged"). aria-label is also kept in sync so SR users hear the
  // destination action — "Switch to dark theme" / "Switch to light theme".
  const syncA11y = () => {
    if (!toggle) return;
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    toggle.setAttribute('aria-pressed', isLight ? 'true' : 'false');
    toggle.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
  };
  syncA11y();
  if (toggle) {
    toggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('alpha-theme', next); } catch {}
      syncA11y();
    });

    // Respond to OS preference changes only if the user hasn't picked manually.
    const mql = window.matchMedia('(prefers-color-scheme: light)');
    mql.addEventListener('change', (e) => {
      try {
        if (localStorage.getItem('alpha-theme')) return;
      } catch {}
      document.documentElement.setAttribute('data-theme', e.matches ? 'light' : 'dark');
      syncA11y();
    });
  }
</script>
