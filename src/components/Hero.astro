---
import SystemFlow from './SystemFlow.astro';

// Buyer-facing proof points, not engineering metrics.
// Entity/service/controller counts say nothing to a broker, COO, or
// compliance officer; coverage, retention, residency, and consolidation
// are what they care about.
//
// `animate` opts a stat into the count-up effect on first reveal. The
// integer + locale-specific suffix are parsed at runtime from the current
// textContent, so the animated suffix follows whatever locale is active.
// "Germany" / "6 → 1" don't lead with a digit and are intentionally skipped.
const stats: { v: string; l: string; animate?: boolean }[] = [
  { v: '64+',     l: 'modules · clean core', animate: true },
  { v: '7-year',  l: 'field-level audit',    animate: true },
  { v: 'Germany', l: 'data residency' },
  { v: '6 → 1',   l: 'tools replaced' },
];
---

<section id="hero" class="relative pt-36 pb-24 lg:pt-44 lg:pb-32 overflow-hidden">
  {/* Ambient background — blobs drift with scroll for subtle depth.
      Each one gets a different speed so they don't move as a group. */}
  <div class="absolute inset-0 -z-10 bg-grid mask-fade-radial opacity-60"></div>
  <div class="blob blob-violet w-[640px] h-[640px] -top-40 -left-40 animate-float-slow"  data-parallax="0.18"></div>
  <div class="blob blob-purple w-[520px] h-[520px] top-1/4 right-[-160px] animate-float-slower" data-parallax="0.12"></div>
  <div class="blob blob-pink   w-[440px] h-[440px] bottom-[-160px] left-1/3 animate-float-slow" data-parallax="0.22"></div>

  <div class="container-wide grid lg:grid-cols-[1.05fr_1fr] gap-14 items-center min-w-0">
    {/* Copy — `data-hero-scrub="text"` opts this column into the GSAP
        ScrollTrigger scene at the bottom of the file. Foreground layer:
        lifts faster than the panel as the user scrolls, opening parallax
        depth between the headline and the system-flow visual. Reveals on
        children still play normally — nested transforms compose. */}
    <div class="min-w-0" data-hero-scrub="text">
      <div class="reveal inline-flex items-center gap-2 badge badge-dot mb-6">
        <span class="ml-2" data-i18n="hero.eyebrow">Insurance Management Platform · Hosted in Germany</span>
      </div>

      <h1
        class="text-balance text-[clamp(2.4rem,6vw,5rem)] font-semibold leading-[1.04] tracking-tight"
        style="overflow-wrap: break-word; hyphens: auto; -webkit-hyphens: auto; min-width: 0;"
      >
        {/* Each line is its own .reveal so we get a per-line entrance, and
            .reveal-line tells the runtime to split each child element's text
            into per-word spans for a writer-style sweep. data-i18n stays on
            child spans (not on the .reveal-line itself) so the i18n runtime
            replaces the inner text without blowing away the line wrapper.
            Timing: per-line offsets are intentionally small (100ms steps);
            the per-word stagger does most of the cascade work. Total hero
            entrance now lands in ~900ms instead of ~1.4s. */}
        <span class="reveal reveal-line block"><span data-i18n="hero.headline.l1">One platform.</span></span>
        <span class="reveal reveal-line block" style="--reveal-delay: 100ms;"><span data-i18n="hero.headline.l2">Every step of</span></span>
        <span class="reveal reveal-line block" style="--reveal-delay: 200ms;">
          <span data-i18n="hero.headline.l3a">the</span>
          <span class="gradient-text-strong" data-i18n="hero.headline.l3b">insurance business.</span>
        </span>
      </h1>

      <p class="reveal mt-7 max-w-xl text-lg text-white/65 leading-relaxed" data-i18n="hero.subtext" style="--reveal-delay: 380ms;">
        Alpha is the modular insurance management platform for brokers, agencies, and distributors —
        customers, contracts, billing, signatures, documents, commissions and the customer portal in
        one audit-grade, multi-tenant system.
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--reveal-delay: 480ms;">
        <a href="#cta" class="btn-primary">
          <span data-i18n="hero.cta.demo">Request a tailored demo</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#how-it-works" class="btn-secondary" data-i18n="hero.cta.seeHow">See how it works</a>
      </div>

      <div class="reveal mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-white/60" style="--reveal-delay: 560ms;">
        <span class="font-mono uppercase tracking-wider mr-1" data-i18n="hero.compliance">Compliance</span>
        {['ISO 27001', 'ISO 27701', 'SOC 2', 'GDPR', 'eIDAS', 'IDD'].map((b) => (
          <span class="px-2 py-1 rounded-md bg-white/[0.03] border border-white/10 text-white/70">{b}</span>
        ))}
      </div>
    </div>

    {/* Visual — three nested transforms, deliberately on three different
        elements so they don't fight for the `transform` property:
          1. data-hero-scrub="panel"  → scroll-driven camera settle (GSAP)
          2. .reveal[data-reveal=scale] → one-shot entrance on first paint
          3. .tilt                     → cursor-following 3D rotation
        The soft glow sits inside (1)/(2) but outside (3) so the bloom stays
        anchored while only the panel itself rotates with the cursor. */}
    <div class="relative" data-hero-scrub="panel">
      <div class="reveal" data-reveal="scale" style="--reveal-delay: 200ms;">
      <div class="absolute -inset-10 bg-alpha-gradient-soft blur-3xl opacity-60 rounded-[40px]"></div>
      <div class="glass-strong tilt relative rounded-[28px] p-5 sm:p-7 shadow-glow-purple">
        <div class="flex items-center justify-between mb-5">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-300/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-300/80"></span>
          </div>
          <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-white/55" data-i18n="hero.live">alpha · live system flow</span>
        </div>
        <SystemFlow />
        <div class="mt-4 flex items-center justify-between text-[11px] font-mono text-white/60 uppercase tracking-wider">
          <span data-i18n="hero.inputs">Inputs · 7 channels</span>
          <span class="hidden sm:inline" data-i18n="hero.workflow">Workflow · WF · NS · TE · LG</span>
          <span data-i18n="hero.outputs">Outputs · audit-trailed</span>
        </div>
      </div>
      </div>
    </div>
  </div>

  {/* Stats strip — numeric values count up on first visible.
      Non-numeric values get a subtle gradient sweep via .stat-value. */}
  <div class="container-wide mt-20 lg:mt-28">
    <div
      class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-white/5 glass rounded-2xl overflow-hidden"
      data-stagger
    >
      {stats.map((s, i) => (
        <div class="reveal spotlight px-6 py-6 text-center transition-colors duration-[var(--t-short)] ease-[var(--ease-soft)] hover:bg-white/[0.02]" data-reveal="scale">
          <div class="text-3xl md:text-4xl font-semibold tracking-tight stat-value">
            <span
              data-i18n={`hero.stats.${i}.v`}
              data-count={s.animate ? '1' : undefined}
              data-count-duration="1100"
            >{s.v}</span>
          </div>
          <div class="text-xs uppercase tracking-[0.18em] text-white/60 mt-1.5" data-i18n={`hero.stats.${i}.l`}>{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Hero scroll-scrubbed scene. The page-wide IntersectionObserver covers
  // entrance reveals; this adds the camera-style depth that separates a
  // static hero from an Apple-style product page — as the user scrolls,
  // the system-flow panel settles back/up like a dolly move and the
  // headline/CTAs lift slightly faster, opening parallax depth between
  // the foreground copy and the background visual.
  //
  // Why GSAP ScrollTrigger and not the existing data-parallax runtime:
  // data-parallax centers each element around viewport center, which is
  // wrong for a hero that lives at the top of the page. We need a scrub
  // pinned to the hero's own bounding box (top→bottom-leaves-viewport).
  //
  // Why three different elements own the panel transform stack:
  //   .panel-stage (this scrub) / .reveal (entrance) / .tilt (cursor 3D)
  // CSS transforms cascade through the DOM, so each effect can own its
  // own element without the others snapping at end-state.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const wireHeroScene = () => {
    const hero = document.querySelector<HTMLElement>('#hero');
    if (!hero) return;
    const panel = hero.querySelector<HTMLElement>('[data-hero-scrub="panel"]');
    const text  = hero.querySelector<HTMLElement>('[data-hero-scrub="text"]');
    if (!panel || !text) return;

    // gsap.matchMedia handles cleanup on resize / preference change.
    // - lg+ only: at smaller widths the layout stacks single-column, so
    //   the depth-parallax conceit (text in front of panel) doesn't apply
    //   and a -110px lift on the headline would just look broken.
    // - reduced-motion: bail entirely; the page already has a static
    //   fallback courtesy of the IntersectionObserver reveals.
    const mm = gsap.matchMedia();
    mm.add(
      '(min-width: 1024px) and (prefers-reduced-motion: no-preference)',
      () => {
        const trigger = {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          // Polish-pass: 0.6 → 0.5. The original felt fractionally sluggish
          // — the panel "caught up" half a beat after the scroll wheel,
          // breaking the illusion of direct manipulation. 0.5 is still
          // smooth enough to absorb wheel jitter but tracks the user's
          // intent more closely.
          scrub: 0.5,
        } as const;

        // Background plate (system-flow panel): subtle camera dolly.
        // Polish-pass magnitudes (vs. -60 / 1.04 / -3): all dialed back
        // ~25%. The original was at the upper end of "Apple subtle";
        // tightening to -44 / 1.025 / -2 makes the move feel like an
        // accent rather than a feature. Restraint reads as confidence.
        gsap.fromTo(
          panel,
          { y: 0, scale: 1, rotateX: 0 },
          { y: -44, scale: 1.025, rotateX: -2, ease: 'none', scrollTrigger: trigger }
        );

        // Foreground plate (headline + CTA + compliance): lifts faster
        // than the panel. Polish-pass: -110 → -84. Same proportional
        // reduction as the panel keeps the foreground/background
        // differential at ~40px (was 50px) — depth still readable, total
        // movement quieter. The hero is no longer the loudest moment
        // on the page.
        gsap.fromTo(
          text,
          { y: 0 },
          { y: -84, ease: 'none', scrollTrigger: trigger }
        );
      }
    );
  };

  wireHeroScene();
  document.addEventListener('astro:page-load', wireHeroScene);
</script>
