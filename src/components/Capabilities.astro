---
type Cat = 'ops' | 'customer' | 'intel' | 'trust';

interface Feature {
  key: string;
  title: string;
  body: string;
  modules: string[];
  icon: string;
  cat: Cat;
  metric: string;
  feature?: boolean;
  side?: 'left' | 'right';
  visual?: 'lifecycle' | 'sepa' | 'ai';
}

const features: Feature[] = [
  {
    key: 'lifecycle',
    title: 'Full customer & contract lifecycle',
    body: 'Lead → application → active customer → claim → renewal in one 360° view. Customers, contracts, products and partners share a single source of truth.',
    modules: ['CR', 'CM', 'LM'],
    icon: 'lifecycle',
    cat: 'ops',
    metric: '360°',
    feature: true,
    side: 'left',
    visual: 'lifecycle',
  },
  {
    key: 'sepa',
    title: 'Agency collection, end to end',
    body: 'SEPA mandates, periodic billing runs, PAIN.008 generation, CAMT-based multi-stage automatic reconciliation, multi-level dunning. Fully automated, fully traceable.',
    modules: ['BM', 'JB', 'WF'],
    icon: 'sepa',
    cat: 'ops',
    metric: 'PAIN.008',
    feature: true,
    side: 'right',
    visual: 'sepa',
  },
  {
    key: 'advisory',
    title: 'IDD-compliant advisory',
    body: 'Case Wizard captures advisory documentation, runs validation, integrates eIDAS-AES signatures, and converts validated applications automatically.',
    modules: ['CW', 'SM'],
    icon: 'advisory',
    cat: 'ops',
    metric: 'IDD',
  },
  {
    key: 'workflow',
    title: 'Configurable workflows',
    body: 'Define processes, conditions, calculations and rules without writing code. SpEL, Groovy, FreeMarker, QL and HTTP. Reusable and inheritable.',
    modules: ['WF', 'LG', 'CE', 'CF'],
    icon: 'workflow',
    cat: 'ops',
    metric: 'no-code',
  },
  {
    key: 'notify',
    title: 'Multi-channel notifications',
    body: 'Email, SMS, Push, Microsoft Teams, WhatsApp — one notification system, template-driven, with full delivery tracking.',
    modules: ['NS', 'TE'],
    icon: 'notify',
    cat: 'customer',
    metric: '5 channels',
  },
  {
    key: 'pdf',
    title: 'Templates & PDF generation',
    body: 'FreeMarker-driven templates produce dynamic, branded PDFs — invoices, advisory records, contracts, dunning letters — with variable linking and test cases.',
    modules: ['TE', 'DM'],
    icon: 'pdf',
    cat: 'customer',
    metric: 'FreeMarker',
  },
  {
    key: 'doc',
    title: 'Document management with OCR',
    body: 'Azure AI Document Intelligence powers automatic OCR, classification and versioning for every uploaded document.',
    modules: ['DM'],
    icon: 'doc',
    cat: 'customer',
    metric: 'OCR',
  },
  {
    key: 'sign',
    title: 'eIDAS-AES digital signatures',
    body: 'Advanced Electronic Signatures across email, SMS, phone or in-person. Integrated providers (InSign and more), every signing event audit-logged.',
    modules: ['SM'],
    icon: 'sign',
    cat: 'customer',
    metric: 'eIDAS-AES',
  },
  {
    key: 'portal',
    title: 'Customer self-service portal',
    body: 'Separate, mobile-ready portal with passwordless OTP login. Customers see contracts, upload documents, file claims, book appointments — 24/7.',
    modules: ['EU', 'EX'],
    icon: 'portal',
    cat: 'customer',
    metric: 'OTP login',
  },
  {
    key: 'ai',
    title: 'AI-powered insights',
    body: 'Ask the system in plain language. The Cognitive Backend translates natural-language questions into QL via Azure OpenAI GPT-4o, grounded in a curated knowledge base.',
    modules: ['CB'],
    icon: 'ai',
    cat: 'intel',
    metric: 'GPT-4o',
    feature: true,
    side: 'left',
    visual: 'ai',
  },
  {
    key: 'integrate',
    title: 'Universal integration framework',
    body: 'REST, SOAP, BiPRO 420/430, GDV files, CSV — connect any partner system through configuration. No partner-specific code in business modules.',
    modules: ['HC', 'HB', 'HG', 'HA'],
    icon: 'integrate',
    cat: 'ops',
    metric: 'BiPRO 420/430',
  },
  {
    key: 'rbac',
    title: '5-level granular permissions',
    body: 'Module → Feature → Object Type → Customer → Contract. Pre-computed access indices for performance. Compliance-grade access for the largest organisations.',
    modules: ['UM'],
    icon: 'rbac',
    cat: 'trust',
    metric: '5 levels',
  },
  {
    key: 'audit',
    title: 'Field-level audit trail',
    body: 'Hibernate Envers records every field change automatically — who, what, before, after, when. 7-year retention. Built-in regulatory readiness.',
    modules: ['envers'],
    icon: 'audit',
    cat: 'trust',
    metric: '7-yr',
  },
  {
    key: 'tenant',
    title: 'True multi-tenancy',
    body: 'Each tenant gets its own PostgreSQL database. Optionally a fully dedicated compute and network — for maximum data isolation and sovereignty.',
    modules: ['infra'],
    icon: 'tenant',
    cat: 'trust',
    metric: 'PG/tenant',
  },
  {
    key: 'shield',
    title: 'Built for compliance',
    body: 'ISO 27001 · ISO 27701 · SOC 2 · GDPR · eIDAS · IDD — engineered to meet the bar of regulated insurance businesses.',
    modules: ['compliance'],
    icon: 'shield',
    cat: 'trust',
    metric: 'ISO 27001',
  },
];

const filters = [
  { id: 'all',      i18n: 'cap.f.all',      label: 'All',          count: features.length },
  { id: 'ops',      i18n: 'cap.f.ops',      label: 'Operations',   count: features.filter(f => f.cat === 'ops').length },
  { id: 'customer', i18n: 'cap.f.customer', label: 'Customer',     count: features.filter(f => f.cat === 'customer').length },
  { id: 'intel',    i18n: 'cap.f.intel',    label: 'Intelligence', count: features.filter(f => f.cat === 'intel').length },
  { id: 'trust',    i18n: 'cap.f.trust',    label: 'Compliance',   count: features.filter(f => f.cat === 'trust').length },
];

const Icon = (name: string) => {
  const stroke = 'stroke="url(#iconGrad)"';
  const common = 'width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
  switch (name) {
    case 'lifecycle': return `<svg ${common}><path ${stroke} d="M21 12a9 9 0 1 1-3.5-7.1"/><path ${stroke} d="M21 4v5h-5"/></svg>`;
    case 'sepa':      return `<svg ${common}><rect ${stroke} x="3" y="6" width="18" height="13" rx="2"/><path ${stroke} d="M3 10h18M7 15h4"/></svg>`;
    case 'advisory':  return `<svg ${common}><path ${stroke} d="M4 4h12l4 4v12H4z"/><path ${stroke} d="M8 10h8M8 14h6M8 18h4"/></svg>`;
    case 'workflow':  return `<svg ${common}><circle ${stroke} cx="6" cy="6" r="2.5"/><circle ${stroke} cx="18" cy="6" r="2.5"/><circle ${stroke} cx="12" cy="18" r="2.5"/><path ${stroke} d="M8 7l4 9M16 7l-4 9"/></svg>`;
    case 'notify':    return `<svg ${common}><path ${stroke} d="M6 8a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z"/><path ${stroke} d="M10 18a2 2 0 0 0 4 0"/></svg>`;
    case 'pdf':       return `<svg ${common}><path ${stroke} d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path ${stroke} d="M14 3v6h6"/><path ${stroke} d="M9 14h6M9 18h4"/></svg>`;
    case 'doc':       return `<svg ${common}><path ${stroke} d="M4 4h12l4 4v12H4z"/><circle ${stroke} cx="12" cy="14" r="3"/></svg>`;
    case 'sign':      return `<svg ${common}><path ${stroke} d="M3 19c4-1 7-7 11-9 2-1 4 1 3 3-2 4-8 7-9 7"/><path ${stroke} d="M14 6l4 4"/></svg>`;
    case 'portal':    return `<svg ${common}><rect ${stroke} x="3" y="4" width="18" height="14" rx="2"/><path ${stroke} d="M3 9h18M8 13h2"/></svg>`;
    case 'ai':        return `<svg ${common}><path ${stroke} d="M12 3v3M12 18v3M3 12h3M18 12h3M5.5 5.5l2 2M16.5 16.5l2 2M5.5 18.5l2-2M16.5 7.5l2-2"/><circle ${stroke} cx="12" cy="12" r="3"/></svg>`;
    case 'integrate': return `<svg ${common}><path ${stroke} d="M9 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h4M15 7h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4M9 12h6"/></svg>`;
    case 'rbac':      return `<svg ${common}><path ${stroke} d="M12 3l8 4v6c0 5-4 7-8 8-4-1-8-3-8-8V7z"/><path ${stroke} d="M9 12l2 2 4-4"/></svg>`;
    case 'audit':     return `<svg ${common}><circle ${stroke} cx="11" cy="11" r="6"/><path ${stroke} d="M16 16l5 5"/><path ${stroke} d="M9 11h4M11 9v4"/></svg>`;
    case 'tenant':    return `<svg ${common}><rect ${stroke} x="3" y="9" width="18" height="11" rx="2"/><path ${stroke} d="M3 13h18M8 16h2M14 16h2"/><path ${stroke} d="M7 9V5a5 5 0 0 1 10 0v4"/></svg>`;
    case 'shield':    return `<svg ${common}><path ${stroke} d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>`;
    default:          return `<svg ${common}><circle ${stroke} cx="12" cy="12" r="8"/></svg>`;
  }
};

const lifecycleStages = [
  { i18n: 'cap.viz.life.0', label: 'Lead' },
  { i18n: 'cap.viz.life.1', label: 'Apply' },
  { i18n: 'cap.viz.life.2', label: 'Active' },
  { i18n: 'cap.viz.life.3', label: 'Claim' },
  { i18n: 'cap.viz.life.4', label: 'Renew' },
];

const sepaStages = [
  { i18n: 'cap.viz.sepa.0', label: 'Mandate' },
  { i18n: 'cap.viz.sepa.1', label: 'PAIN.008' },
  { i18n: 'cap.viz.sepa.2', label: 'CAMT' },
  { i18n: 'cap.viz.sepa.3', label: 'Reconciled' },
];
---

<section id="capabilities" class="section relative">
  <div class="absolute inset-0 -z-10 bg-grid opacity-20 mask-fade-bottom"></div>
  <div class="cap-aurora" aria-hidden="true"></div>

  <div class="container-wide">
    <div class="max-w-2xl reveal">
      <p class="section-eyebrow" data-i18n="cap.eyebrow">Capabilities</p>
      <h2 class="section-heading mt-3">
        <span data-i18n="cap.heading.a">What Alpha actually</span>
        <span class="gradient-text" data-i18n="cap.heading.b">does for you.</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed" data-i18n="cap.body">
        Fifteen capabilities, one platform. Each one delivered by composable modules — no add-ons, no plugins, no shadow IT.
      </p>
    </div>

    <div class="cap-stats reveal mt-8" data-reveal="scale">
      <span class="cap-stat">
        <span class="cap-stat-num" data-count data-count-duration="1200">15</span>
        <span class="cap-stat-label" data-i18n="cap.stat.caps">capabilities</span>
      </span>
      <span class="cap-stat-sep" aria-hidden="true">·</span>
      <span class="cap-stat">
        <span class="cap-stat-num" data-count data-count-duration="900">0</span>
        <span class="cap-stat-label" data-i18n="cap.stat.plugins">plugins</span>
      </span>
      <span class="cap-stat-sep" aria-hidden="true">·</span>
      <span class="cap-stat">
        <span class="cap-stat-num" data-count data-count-duration="900">1</span>
        <span class="cap-stat-label" data-i18n="cap.stat.platform">platform</span>
      </span>
    </div>

    {/* Filter chips: filter the same grid in place; not a tabs pattern.
        See Modules.astro for the same rationale — `aria-pressed` is the
        right semantic for "this filter is on." */}
    <div class="cap-filters reveal mt-7" data-reveal="scale" role="group" aria-label="Filter capabilities">
      {filters.map((f, i) => (
        <button
          type="button"
          class={`cap-filter ${i === 0 ? 'is-active' : ''}`}
          data-cap-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`Show ${f.label} capabilities (${f.count})`}
        >
          <span data-i18n={f.i18n}>{f.label}</span>
          <span class="cap-filter-count" aria-hidden="true">{f.count}</span>
        </button>
      ))}
    </div>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="iconGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#c4b5fd"/>
          <stop offset="100%" stop-color="#f093fb"/>
        </linearGradient>
      </defs>
    </svg>

    <div class="cap-bento mt-8" data-stagger data-stagger-step="55" data-cap-grid>
      {features.map((f) => (
        <article
          class={`cap-card reveal spotlight tilt group ${f.feature ? 'is-feature' : ''} ${f.side === 'right' ? 'feature-right' : ''}`}
          data-cap-card
          data-cap-cat={f.cat}
          data-reveal={f.feature ? 'blur' : undefined}
        >
          <span class="cap-sheen" aria-hidden="true"></span>
          <span class="cap-card-strip" aria-hidden="true"></span>
          <span class="cap-card-bottom-sweep" aria-hidden="true" style={`--phase:${(features.indexOf(f) % 5) * 0.6}s`}></span>
          <span class="cap-card-metric font-mono">{f.metric}</span>

          {f.visual === 'lifecycle' && (
            <div class="cap-viz cap-viz-lifecycle" aria-hidden="true">
              <div class="cap-viz-line"></div>
              <div class="cap-viz-pulse"></div>
              <div class="cap-viz-stages">
                {lifecycleStages.map((s, i) => (
                  <div class="cap-viz-node" style={`--i:${i}`}>
                    <span class="cap-viz-dot"></span>
                    <span class="cap-viz-label" data-i18n={s.i18n}>{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {f.visual === 'sepa' && (
            <div class="cap-viz cap-viz-sepa" aria-hidden="true">
              {sepaStages.map((s, i) => (
                <div class="cap-viz-row" style={`--i:${i}`}>
                  <span class="cap-viz-row-label" data-i18n={s.i18n}>{s.label}</span>
                  <span class="cap-viz-bar"><span class="cap-viz-bar-fill"></span></span>
                  <span class="cap-viz-tick">✓</span>
                </div>
              ))}
            </div>
          )}

          {f.visual === 'ai' && (
            <div class="cap-viz cap-viz-ai" aria-hidden="true">
              <div class="cap-viz-prompt">
                <span class="cap-viz-prompt-prefix">›</span>
                <span class="cap-viz-prompt-text" data-i18n="cap.viz.ai.prompt">show billed premium for Q1, by product</span>
                <span class="cap-viz-caret"></span>
              </div>
              <div class="cap-viz-arrow">↓</div>
              <div class="cap-viz-ql">
                <span class="cap-viz-ql-tag">QL</span>
                <code>select sum(premium) group by product where q=1</code>
              </div>
              <div class="cap-viz-result">
                <span class="cap-viz-result-dot"></span>
                <span data-i18n="cap.viz.ai.result">4 rows · 312 ms · audit logged</span>
              </div>
            </div>
          )}

          <div class="cap-card-head">
            <span class="cap-icon-plate icon-plate icon-plate-spring grid place-items-center w-10 h-10 rounded-xl" set:html={Icon(f.icon)}></span>
            <div class="cap-modules flex-1 flex flex-wrap gap-1.5">
              {f.modules.map((m, mi) => (
                <span class="cap-module-pill font-mono text-[10px] px-1.5 py-0.5 rounded bg-white/[0.04] border border-white/10 text-white/55 tracking-wider" style={`--m:${mi}`}>{m}</span>
              ))}
            </div>
          </div>

          <h3 class="cap-card-title" data-i18n={`cap.${f.icon}.title`}>{f.title}</h3>
          <p class="cap-card-body" data-i18n={`cap.${f.icon}.body`}>{f.body}</p>

          <span class="cap-card-corner" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M3 7h8M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </article>
      ))}
    </div>
  </div>

  <script>
    // Capabilities filter chips: clicking a chip filters the bento.
    // Cards with non-matching .data-cap-cat get .is-hidden which fades+
    // shrinks them and removes them from layout via display:none after a
    // short transition, letting the grid reflow naturally.
    const grid = document.querySelector<HTMLElement>('[data-cap-grid]');
    const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-cap-filter]'));
    if (grid && chips.length) {
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const id = chip.dataset.capFilter || 'all';
          chips.forEach((c) => {
            const active = c === chip;
            c.classList.toggle('is-active', active);
            c.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          const cards = grid.querySelectorAll<HTMLElement>('[data-cap-card]');
          cards.forEach((card) => {
            const matches = id === 'all' || card.dataset.capCat === id;
            card.classList.toggle('is-hidden', !matches);
          });
        });
      });
    }
  </script>
</section>
