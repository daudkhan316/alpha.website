---
const fragmented = [
  { code: 'CRM',    key: 'ps.tool.crm',    label: 'Customer database' },
  { code: 'POL',    key: 'ps.tool.pol',    label: 'Policy admin' },
  { code: 'SEPA',   key: 'ps.tool.sepa',   label: 'SEPA collection' },
  { code: 'DUN',    key: 'ps.tool.dun',    label: 'Dunning tool' },
  { code: 'DOCS',   key: 'ps.tool.docs',   label: 'Document store' },
  { code: 'eSIGN',  key: 'ps.tool.esign',  label: 'E-signature' },
  { code: 'PORTAL', key: 'ps.tool.portal', label: 'Customer portal' },
];

const consolidated: { code: string; key: string; label: string }[] = [
  { code: 'CR', key: 'ps.cons.cr', label: 'Customer 360' },
  { code: 'CM', key: 'ps.cons.cm', label: 'Contracts & products' },
  { code: 'BM', key: 'ps.cons.bm', label: 'SEPA · CAMT · dunning' },
  { code: 'DM', key: 'ps.cons.dm', label: 'Docs · OCR · versioning' },
  { code: 'SM', key: 'ps.cons.sm', label: 'eIDAS-AES signatures' },
  { code: 'EU', key: 'ps.cons.eu', label: 'Customer self-service' },
  { code: 'CW', key: 'ps.cons.cw', label: 'IDD-compliant advisory' },
  { code: 'CP', key: 'ps.cons.cp', label: 'Commissions' },
];

const minusPills = ['media breaks', 'data silos', 'license sprawl', 'integration cost', 'audit gaps'];
const plusPills  = ['clean core', 'configuration-driven', 'multi-tenant', 'field-level audit', 'azure germany'];
---

<section id="why" class="section ps-section">
  <div class="absolute inset-0 -z-10 bg-grid opacity-30 mask-fade-bottom"></div>

  <div class="container-wide">
    <div class="max-w-2xl reveal">
      <p class="section-eyebrow" data-i18n="ps.eyebrow">From fragmentation to one clean core</p>
      <h2 class="section-heading mt-3">
        <span data-i18n="ps.heading.a">Six tools, six bills,</span>
        <span class="gradient-text" data-i18n="ps.heading.b">six places</span>
        <span data-i18n="ps.heading.c">for the same customer.</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed" data-i18n="ps.body">
        Insurance brokers and agencies operate stacks stitched together from CRM, policy admin, SEPA collection,
        dunning, document storage, e-sign and portal vendors. The result is media breaks, compliance gaps and
        rising integration cost. Alpha replaces those stacks with one configuration-driven platform.
      </p>
    </div>

    <div class="mt-16 grid lg:grid-cols-[1fr_auto_1fr] gap-8 lg:gap-4 items-stretch">
      {/* Before */}
      <div class="reveal">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-400 ps-pulse-dot"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-rose-300/80" data-i18n="ps.before.label">The fragmented stack</span>
        </div>
        <div class="relative rounded-2xl border border-rose-500/15 bg-rose-500/[0.025] p-6 min-h-[320px] overflow-hidden">
          <svg class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
            <defs>
              <pattern id="brokenLines" width="36" height="36" patternUnits="userSpaceOnUse">
                <path d="M0 0 L36 36" stroke="rgba(244,63,94,0.18)" stroke-width="0.5" stroke-dasharray="3 4">
                  <animate attributeName="stroke-dashoffset" from="0" to="-14" dur="6s" repeatCount="indefinite"/>
                </path>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#brokenLines)"/>
          </svg>
          <div class="relative grid grid-cols-3 gap-3">
            {fragmented.map((t, i) => (
              <div
                class={`glass rounded-xl px-3 py-3 text-center ps-frag-tile ${i % 2 === 0 ? 'rotate-[-1.5deg]' : 'rotate-[1.5deg]'}`}
                style={`--frag-i:${i}; transform-origin: center; ${i === 6 ? 'grid-column: 1 / span 3;' : ''}`}
              >
                <div class="font-mono text-xs tracking-wider text-white/85">{t.code}</div>
                <div class="text-[10px] text-white/40 mt-1 uppercase tracking-wider" data-i18n={t.key}>{t.label}</div>
              </div>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap gap-2 text-[11px]">
            {minusPills.map((p, i) => (
              <span class="px-2 py-1 rounded-md border border-rose-400/20 text-rose-200/70">
                — <span data-i18n={`ps.minus.${i}`}>{p}</span>
              </span>
            ))}
          </div>
        </div>
      </div>

      {/* Arrow */}
      <div class="hidden lg:flex items-center justify-center px-2">
        <div class="relative w-24 h-24 ps-arrow-bloom">
          <div class="absolute inset-0 rounded-full bg-alpha-gradient blur-2xl opacity-50"></div>
          <div class="absolute inset-0 grid place-items-center">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" class="ps-arrow-svg">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="url(#arrG)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="arrG" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#667eea"/>
                  <stop offset="100%" stop-color="#f093fb"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>

      {/* After */}
      <div class="reveal">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 ps-pulse-dot ps-pulse-dot--green"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-emerald-200/80" data-i18n="ps.after.label">Alpha · one clean core</span>
        </div>
        <div class="relative rounded-2xl p-[1px] bg-alpha-gradient overflow-hidden ps-after-shell">
          <div class="relative rounded-2xl bg-alpha-ink/95 p-6 min-h-[320px]">
            <div class="absolute -top-20 -right-20 w-60 h-60 rounded-full bg-alpha-purple/30 blur-3xl ps-blob-drift"></div>
            <div class="relative flex items-center gap-3 mb-5">
              <span class="relative inline-block w-10 h-10 rounded-lg bg-alpha-gradient shadow-glow-violet ps-alpha-mark">
                <span class="absolute inset-0 grid place-items-center text-white font-bold">α</span>
              </span>
              <div>
                <div class="font-semibold tracking-tight" data-i18n="ps.after.title">Alpha Platform</div>
                <div class="text-xs text-white/45 font-mono" data-i18n="ps.after.tagline">modular monolith · clean core</div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              {consolidated.map((c, i) => (
                <div class="ps-cons-tile flex items-center gap-2.5 px-2.5 py-2 rounded-lg bg-white/[0.03] border border-white/5" style={`--cons-i:${i}`}>
                  <span class="font-mono text-[10px] font-semibold tracking-wider gradient-text-strong w-7 text-center">{c.code}</span>
                  <span class="text-xs text-white/75" data-i18n={c.key}>{c.label}</span>
                </div>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2 text-[11px]">
              {plusPills.map((p, i) => (
                <span class="px-2 py-1 rounded-md border border-emerald-300/15 text-emerald-200/80">
                  + <span data-i18n={`ps.plus.${i}`}>{p}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .ps-section { position: relative; }

  /* ────────────── subtle motion ────────────── */
  .ps-frag-tile {
    opacity: 0;
    transform: translateY(-90px) rotate(0deg) scale(0.92);
    transition: transform var(--t-short) var(--ease-soft),
                background var(--t-short) var(--ease-soft),
                border-color var(--t-short) var(--ease-soft);
    animation: none;
  }
  .reveal.is-visible .ps-frag-tile {
    animation:
      psFragDrop 720ms var(--ease-spring) calc(var(--frag-i, 0) * 110ms) both,
      psFragWobble 7s ease-in-out calc(820ms + var(--frag-i, 0) * 110ms) infinite;
  }
  .ps-frag-tile:hover {
    transform: translateY(-2px) rotate(0deg) scale(1.02);
    border-color: rgba(244,63,94,0.30);
  }

  @keyframes psFragDrop {
    0% {
      opacity: 0;
      transform: translateY(-90px) rotate(0deg) scale(0.92);
    }
    55% {
      opacity: 1;
      transform: translateY(6px) rotate(var(--rot, 0deg)) scale(1.03);
    }
    78% {
      transform: translateY(-3px) rotate(var(--rot, 0deg)) scale(1);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(var(--rot, 0deg)) scale(1);
    }
  }

  @keyframes psFragWobble {
    0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
    50%      { transform: translateY(-3px) rotate(0deg); }
  }
  .ps-frag-tile.rotate-\[-1\.5deg\] { --rot: -1.5deg; }
  .ps-frag-tile.rotate-\[1\.5deg\]  { --rot:  1.5deg; }

  .ps-pulse-dot {
    box-shadow: 0 0 0 0 rgba(244,63,94,0.6);
    animation: psPulseDot 2.4s ease-out infinite;
  }
  .ps-pulse-dot--green {
    box-shadow: 0 0 0 0 rgba(52,211,153,0.6);
    animation-name: psPulseDotGreen;
  }
  @keyframes psPulseDot {
    0%   { box-shadow: 0 0 0 0 rgba(244,63,94,0.55); }
    70%  { box-shadow: 0 0 0 8px rgba(244,63,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(244,63,94,0); }
  }
  @keyframes psPulseDotGreen {
    0%   { box-shadow: 0 0 0 0 rgba(52,211,153,0.55); }
    70%  { box-shadow: 0 0 0 8px rgba(52,211,153,0); }
    100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); }
  }

  .ps-arrow-bloom .ps-arrow-svg {
    animation: psArrowDrift 3s ease-in-out infinite;
  }
  @keyframes psArrowDrift {
    0%, 100% { transform: translateX(0); }
    50%      { transform: translateX(4px); }
  }
  .ps-arrow-bloom > div:first-child {
    animation: psArrowGlow 3s ease-in-out infinite;
  }
  @keyframes psArrowGlow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 0.85; transform: scale(1.08); }
  }

  .ps-after-shell {
    background-size: 200% 200%;
    animation: psShellSweep 9s linear infinite;
  }
  @keyframes psShellSweep {
    0%   { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  .ps-blob-drift { animation: psBlobDrift 12s ease-in-out infinite; }
  @keyframes psBlobDrift {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.55; }
    50%      { transform: translate(-12px, 8px) scale(1.06); opacity: 0.8; }
  }

  .ps-alpha-mark { animation: psMarkPulse 3.4s ease-in-out infinite; }
  @keyframes psMarkPulse {
    0%, 100% { box-shadow: 0 0 60px rgba(102,126,234,0.40); }
    50%      { box-shadow: 0 0 80px rgba(240,147,251,0.55); }
  }

  .ps-cons-tile {
    transition: transform var(--t-short) var(--ease-soft),
                background var(--t-short) var(--ease-soft),
                border-color var(--t-short) var(--ease-soft),
                box-shadow var(--t-short) var(--ease-soft);
  }
  .ps-cons-tile:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,0.06);
    border-color: rgba(240,147,251,0.25);
    box-shadow: 0 0 0 1px rgba(240,147,251,0.10) inset;
  }
  .reveal.is-visible .ps-cons-tile {
    animation: psConsLand 700ms var(--ease-spring) both;
    animation-delay: calc(120ms + var(--cons-i, 0) * 60ms);
  }
  @keyframes psConsLand {
    0%   { opacity: 0; transform: translateY(8px) scale(0.98); }
    100% { opacity: 1; transform: translateY(0)  scale(1); }
  }


  /* Reduced-motion: kill all decorative loops, keep state changes */
  @media (prefers-reduced-motion: reduce) {
    .ps-frag-tile,
    .reveal.is-visible .ps-frag-tile,
    .ps-arrow-bloom .ps-arrow-svg,
    .ps-arrow-bloom > div:first-child,
    .ps-after-shell,
    .ps-blob-drift,
    .ps-alpha-mark,
    .ps-pulse-dot {
      animation: none !important;
    }
    .ps-frag-tile {
      opacity: 1;
      transform: none;
    }
  }
</style>
