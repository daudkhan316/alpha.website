---
// Animated SVG system flow:
//   inputs  →  Alpha core  →  outputs
// Particles travel curved paths via SMIL animateMotion (zero-JS, GPU-cheap).

const inputs = [
  { code: 'LEAD', label: 'Lead form' },
  { code: 'BIPRO', label: 'BiPRO 420/430' },
  { code: 'GDV', label: 'GDV file' },
  { code: 'REST', label: 'REST / SOAP' },
  { code: 'PORTAL', label: 'Web portal' },
];
const outputs = [
  { code: 'CM', label: 'Contract' },
  { code: 'BM', label: 'SEPA · PAIN.008' },
  { code: 'SM', label: 'eIDAS signature' },
  { code: 'NS', label: 'Notification' },
  { code: 'AUDIT', label: 'Field-level audit' },
];

const inputY = (i: number) => 70 + i * 65;
const outputY = (i: number) => 70 + i * 65;
---

<div class="relative w-full" data-flow>
  {/* `data-flow` opts this container into the scroll-velocity-driven
      energy runtime in Layout.astro. A `--flow-energy` var (0…1) is
      written here on each scroll-rAF; particles + the core ring below
      read it to brighten while the user is scrolling and decay back to
      baseline ~1s after they stop. The diagram feels like it responds
      to attention rather than running on a fixed loop. */}
  <svg
    viewBox="0 0 800 460"
    class="w-full h-auto"
    role="img"
    aria-label="Alpha Platform system flow: inputs feeding the core, outputs leaving"
  >
    <defs>
      <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"  stop-color="#667eea" stop-opacity="0.0"/>
        <stop offset="20%" stop-color="#667eea" stop-opacity="0.4"/>
        <stop offset="80%" stop-color="#f093fb" stop-opacity="0.4"/>
        <stop offset="100%" stop-color="#f093fb" stop-opacity="0.0"/>
      </linearGradient>
      <radialGradient id="coreGrad" cx="50%" cy="50%" r="50%">
        <stop offset="0%"  stop-color="#f093fb" stop-opacity="0.95"/>
        <stop offset="55%" stop-color="#764ba2" stop-opacity="0.9"/>
        <stop offset="100%" stop-color="#08061a" stop-opacity="0.6"/>
      </radialGradient>
      <radialGradient id="haloGrad" cx="50%" cy="50%" r="50%">
        <stop offset="0%"  stop-color="#f093fb" stop-opacity="0.35"/>
        <stop offset="60%" stop-color="#764ba2" stop-opacity="0.10"/>
        <stop offset="100%" stop-color="#764ba2" stop-opacity="0"/>
      </radialGradient>
      <filter id="soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" />
      </filter>
      {/* pathLength="1" normalizes stroke-dasharray math across all paths
          regardless of actual curve length, so the .flow-line draw-in CSS
          (global.css) can use a single unitless dasharray of 1 instead of
          measuring each path with JS. Doesn't affect <animateMotion>; mpath
          uses geometric length, not pathLength. */}
      {inputs.map((_, i) => (
        <path
          id={`pIn${i}`}
          d={`M 130 ${inputY(i)} C 250 ${inputY(i)}, 300 230, 380 230`}
          pathLength="1"
          fill="none"
        />
      ))}
      {outputs.map((_, i) => (
        <path
          id={`pOut${i}`}
          d={`M 420 230 C 500 230, 550 ${outputY(i)}, 670 ${outputY(i)}`}
          pathLength="1"
          fill="none"
        />
      ))}
    </defs>

    {/* halo behind core — two layers for softer falloff */}
    <circle cx="400" cy="230" r="200" fill="url(#haloGrad)" opacity="0.85" />
    <circle cx="400" cy="230" r="120" fill="url(#haloGrad)" opacity="0.55" />

    {/* connection lines: a faint base + a drifting scan dot per line.
        The scan keeps the diagram feeling "live" even when no particle is on it.
        `.flow-line` on the gradient base draws in via stroke-dashoffset once
        the parent .reveal becomes visible — see global.css. --line-delay
        bakes the baseline (~700ms, after the panel's own scale-in finishes)
        plus a per-line 60ms stagger so the diagram materializes left-to-right
        through inputs and out through outputs. */}
    {inputs.map((_, i) => (
      <>
        <use href={`#pIn${i}`} stroke="url(#lineGrad)" stroke-width="1.4" fill="none"
             class="flow-line" style={`--line-delay:${700 + i * 60}ms`} />
        <use href={`#pIn${i}`} stroke="rgba(240,147,251,0.55)" stroke-width="1.2" fill="none"
             class="flow-scan" style={`animation-delay:${i * 0.45}s`} />
      </>
    ))}
    {outputs.map((_, i) => (
      <>
        <use href={`#pOut${i}`} stroke="url(#lineGrad)" stroke-width="1.4" fill="none"
             class="flow-line" style={`--line-delay:${700 + (5 + i) * 60}ms`} />
        <use href={`#pOut${i}`} stroke="rgba(102,126,234,0.55)" stroke-width="1.2" fill="none"
             class="flow-scan" style={`animation-delay:${0.6 + i * 0.45}s`} />
      </>
    ))}

    {/* Input nodes — outer pill pulses when its particle reaches the core. */}
    {inputs.map((n, i) => (
      <g>
        <rect x="20" y={inputY(i) - 16} width="112" height="32" rx="16"
              fill="none" stroke="rgba(102,126,234,0.7)" stroke-width="1"
              class="flow-node-pulse"
              style={`animation-delay:${0.15 + i * 0.32}s`} />
        <rect x="22" y={inputY(i) - 14} width="108" height="28" rx="14"
              fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.14)" />
        <text x="76" y={inputY(i) + 4} text-anchor="middle"
              font-family="JetBrains Mono, monospace" font-size="10.5"
              fill="rgba(255,255,255,0.85)" letter-spacing="0.06em">{n.code}</text>
      </g>
    ))}

    {/* Output nodes — pulse when their outbound particle "lands". */}
    {outputs.map((n, i) => (
      <g>
        <rect x="668" y={outputY(i) - 16} width="112" height="32" rx="16"
              fill="none" stroke="rgba(240,147,251,0.7)" stroke-width="1"
              class="flow-node-pulse"
              style={`animation-delay:${1.0 + i * 0.32}s`} />
        <rect x="670" y={outputY(i) - 14} width="108" height="28" rx="14"
              fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.14)" />
        <text x="724" y={outputY(i) + 4} text-anchor="middle"
              font-family="JetBrains Mono, monospace" font-size="10.5"
              fill="rgba(255,255,255,0.85)" letter-spacing="0.06em">{n.code}</text>
      </g>
    ))}

    {/* Core */}
    <g>
      {/* outermost ring — slow expansion, suggests system pulse */}
      <circle cx="400" cy="230" r="92" fill="url(#coreGrad)" filter="url(#soft)" opacity="0.75"/>
      <circle cx="400" cy="230" r="64" fill="rgba(8,6,26,0.85)" stroke="rgba(255,255,255,0.22)" stroke-width="1"/>
      <circle cx="400" cy="230" r="64" fill="none" stroke="url(#lineGrad)" stroke-width="1" opacity="0.6">
        <animate attributeName="r" values="64;78;64" dur="4s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.6;0;0.6" dur="4s" repeatCount="indefinite"/>
      </circle>
      <circle cx="400" cy="230" r="64" fill="none" stroke="rgba(240,147,251,0.5)" stroke-width="1" opacity="0">
        <animate attributeName="r" values="64;88;64" dur="4s" begin="2s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.5;0;0.5" dur="4s" begin="2s" repeatCount="indefinite"/>
      </circle>
      {/* Scroll-energy ring — opacity & scale driven by [data-flow]'s
          --flow-energy var. Independent of the SMIL ambient pulses
          above; rises during scroll, decays back to invisible at rest.
          Sits between the static stroke ring and the SMIL-pulsing rings
          so its glow reads as an *intensification* of the core, not a
          fourth competing animation. */}
      <circle cx="400" cy="230" r="74" fill="none"
              stroke="rgba(240,147,251,0.65)" stroke-width="1.4"
              class="flow-core-energy"/>
      <text x="400" y="222" text-anchor="middle" font-family="Inter, sans-serif"
            font-size="11" fill="rgba(255,255,255,0.55)" letter-spacing="0.18em">ALPHA CORE</text>
      <text x="400" y="252" text-anchor="middle" font-family="Inter, sans-serif"
            font-size="22" font-weight="700" fill="white">α</text>
    </g>

    {/* Particles — driven by the scroll-energy runtime in the script
        below, NOT SMIL. data-progress carries each particle's initial
        position along its path (spread out across the path so the
        diagram doesn't look bunched at startup); data-rate is
        cycles-per-second at energy = 1, preserved from the original
        SMIL durations. cx/cy are placeholder values; the script
        positions each particle on first frame. */}
    {inputs.map((_, i) => (
      <circle r="2.5" cx="0" cy="0" class="flow-particle"
              data-particle data-path={`#pIn${i}`}
              data-progress={(i * 0.2).toFixed(2)}
              data-rate={(1 / (2.6 + i * 0.18)).toFixed(4)} />
    ))}
    {outputs.map((_, i) => (
      <circle r="2.5" cx="0" cy="0" class="flow-particle"
              data-particle data-path={`#pOut${i}`}
              data-progress={(0.1 + i * 0.2).toFixed(2)}
              data-rate={(1 / (2.4 + i * 0.18)).toFixed(4)} />
    ))}
  </svg>

  {/* Floating labels keyed to nodes (positioned with absolute % to overlay svg) */}
  <div class="absolute inset-0 pointer-events-none hidden md:block">
    {inputs.map((n, i) => (
      <span
        class="absolute font-mono text-[10px] tracking-wider uppercase text-white/45"
        style={`left: 1.5%; top: ${(inputY(i) + 18) / 460 * 100}%;`}
      >
        {n.label}
      </span>
    ))}
    {outputs.map((n, i) => (
      <span
        class="absolute font-mono text-[10px] tracking-wider uppercase text-white/45 text-right"
        style={`right: 1%; top: ${(outputY(i) + 18) / 460 * 100}%;`}
      >
        {n.label}
      </span>
    ))}
  </div>
</div>

<script>
  // Scroll-energy-driven particle motion. The original SMIL animateMotion
  // looped from page load — particles streamed perpetually whether the
  // user was looking or not, burning paint cycles for no narrative gain.
  // Now each particle's progress along its path is integrated from
  // --flow-energy (written by Layout.astro's scroll-velocity runtime),
  // so particles only move while the user is scrolling and freeze where
  // they are when the user stops. Combined with the .is-flowing class
  // toggle below, the entire diagram has TWO states — at rest, asleep;
  // attended-to, alive.
  const wireFlow = () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    const container = document.querySelector<HTMLElement>('[data-flow]');
    if (!container) return;
    const particles = Array.from(container.querySelectorAll<SVGCircleElement>('[data-particle]')).map((el) => {
      const ref = el.dataset.path || '';
      const path = document.querySelector<SVGPathElement>(ref);
      if (!path) return null;
      return {
        el,
        path,
        length: path.getTotalLength(),
        progress: Number(el.dataset.progress || '0'),
        rate: Number(el.dataset.rate || '0.4'),
      };
    }).filter((p): p is NonNullable<typeof p> => p !== null);

    // Position each particle at its initial progress so they're visible
    // (spread along the paths) before the first scroll, instead of all
    // bunched at the path origin or hidden off-canvas.
    particles.forEach((p) => {
      const pt = p.path.getPointAtLength(p.progress * p.length);
      p.el.setAttribute('cx', String(pt.x));
      p.el.setAttribute('cy', String(pt.y));
    });

    let frame = 0;
    let lastT = 0;
    const tick = (t: number) => {
      frame = 0;
      if (!lastT) lastT = t;
      // Cap dt to prevent jump if the rAF was paused (tab backgrounded).
      const dt = Math.min(0.05, (t - lastT) / 1000);
      lastT = t;
      const energy = Number(container.style.getPropertyValue('--flow-energy') || '0');

      if (energy > 0.002) {
        container.classList.add('is-flowing');
        for (const p of particles) {
          p.progress = (p.progress + dt * energy * p.rate) % 1;
          const pt = p.path.getPointAtLength(p.progress * p.length);
          p.el.setAttribute('cx', String(pt.x));
          p.el.setAttribute('cy', String(pt.y));
        }
        frame = requestAnimationFrame(tick);
      } else {
        container.classList.remove('is-flowing');
        lastT = 0;
      }
    };

    // Kick off the rAF on every scroll. Layout.astro's scroll handler
    // also fires (registered before this one), so it bumps --flow-energy
    // FIRST, then we read the fresh value on our next frame.
    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(tick);
    }, { passive: true });
  };
  wireFlow();
  document.addEventListener('astro:page-load', wireFlow);
</script>
