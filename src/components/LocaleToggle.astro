---
// EN/DE toggle pill. Initial state is set inline in Layout.astro <head>.
---

<button
  type="button"
  data-locale-toggle
  aria-label="Switch language"
  data-i18n-aria-label="locale.switch"
  title="EN / DE"
  class="relative inline-flex items-center h-11 rounded-full overflow-hidden font-mono text-[11px] tracking-wider"
  style="background: var(--surface-strong); border: 1px solid var(--border-3); color: var(--fg);"
>
  <span data-locale-pill="en" class="px-2.5 h-full grid place-items-center transition-colors">EN</span>
  <span data-locale-pill="de" class="px-2.5 h-full grid place-items-center transition-colors">DE</span>
</button>

<style>
  /* Inactive locale pill is muted; active locale pill is highlighted via the
     gradient background. CSS only — no JS for the visual state. */
  [data-locale-toggle] [data-locale-pill] { color: color-mix(in srgb, var(--fg) 55%, transparent); }
  :root[data-locale='en'] [data-locale-toggle] [data-locale-pill='en'],
  :root[data-locale='de'] [data-locale-toggle] [data-locale-pill='de'] {
    color: #fff;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 60%, #f093fb 100%);
  }
</style>

<script>
  import { applyLocale, persistLocale, locales, type Locale } from '../i18n/runtime';

  const btn = document.querySelector<HTMLButtonElement>('[data-locale-toggle]');
  if (btn) {
    btn.addEventListener('click', () => {
      const current = (document.documentElement.getAttribute('data-locale') as Locale | null) ?? 'en';
      const next: Locale = current === 'en' ? 'de' : 'en';
      applyLocale(next);
      persistLocale(next);
      window.dispatchEvent(new CustomEvent('alpha:locale-changed', { detail: { locale: next } }));
    });
  }
</script>
