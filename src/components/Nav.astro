---
import ThemeToggle from './ThemeToggle.astro';
import LocaleToggle from './LocaleToggle.astro';

const links = [
  { href: '#modules',       label: 'Modules',      key: 'nav.modules' },
  { href: '#how-it-works',  label: 'How it works', key: 'nav.howItWorks' },
  { href: '#capabilities',  label: 'Capabilities', key: 'nav.capabilities' },
  { href: '#ai',            label: 'AI',           key: 'nav.ai' },
  { href: '#use-cases',     label: 'Use cases',    key: 'nav.useCases' },
  { href: '#architecture',  label: 'Architecture', key: 'nav.architecture' },
];
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
  data-nav
>
  <div class="container-wide">
    <nav data-nav-bar class="mt-4 flex items-center justify-between rounded-full px-4 lg:px-6 py-3 glass transition-[padding,margin] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]">
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group min-w-0" aria-label="Klaus — Alpha Platform home">
        <img
          src="/klaus-logo-white.svg"
          alt="Klaus"
          width="84" height="26"
          class="show-on-dark h-[22px] w-auto select-none shrink-0 transition-[height] duration-300"
          loading="eager"
          decoding="async"
        />
        <img
          src="/klaus-logo-color.svg"
          alt="Klaus"
          width="84" height="26"
          class="show-on-light h-[22px] w-auto select-none shrink-0 transition-[height] duration-300"
          loading="eager"
          decoding="async"
        />
        <span class="inline-block w-px h-5 bg-white/15 shrink-0"></span>
        <span class="font-semibold tracking-tight text-white text-sm truncate">Alpha Platform</span>
      </a>

      <div class="hidden lg:flex items-center gap-1">
        {links.map((l) => (
          <a
            href={l.href}
            class="px-3 py-1.5 rounded-full text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors"
          >
            <span data-i18n={l.key}>{l.label}</span>
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2 shrink-0">
        {/* Locale + theme toggles only show on the header at sm+ — on the
            smallest viewport the brand wordmark gets squeezed if all four
            controls (locale, theme, demo, hamburger) sit together. The
            same toggles are mirrored inside the mobile drawer below. */}
        <div class="hidden sm:flex items-center gap-2">
          <LocaleToggle />
          <ThemeToggle />
        </div>
        <a href="#cta" class="hidden sm:inline-flex btn-primary text-sm py-2 px-4">
          <span data-i18n="nav.requestDemo">Request demo</span>
        </a>

        <button
          type="button"
          data-mobile-toggle
          aria-label="Open menu"
          data-i18n-aria-label="nav.openMenu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="lg:hidden relative inline-grid place-items-center w-11 h-11 rounded-full"
          style="background: var(--surface-strong); border: 1px solid var(--border-3);"
        >
          <span data-icon="open" class="block">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
          </span>
          <span data-icon="close" class="hidden">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"/>
            </svg>
          </span>
        </button>
      </div>
    </nav>
  </div>
</header>

{/* Mobile menu — drawer + backdrop, hidden on lg.
    `inert` is set on the panel when closed so the off-screen drawer's
    links/buttons don't end up in the keyboard tab order. The script
    flips `inert` and `aria-hidden` together when opening/closing. */}
<div
  id="mobile-menu"
  data-mobile-panel
  class="lg:hidden fixed inset-0 z-[60] pointer-events-none"
  aria-hidden="true"
  inert
>
  <div data-mobile-backdrop class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300"></div>

  <div
    data-mobile-drawer
    class="absolute right-0 top-0 bottom-0 w-[88%] max-w-sm translate-x-full transition-transform duration-[350ms] ease-[cubic-bezier(0.22,1,0.36,1)] flex flex-col"
    style="background: var(--bg); border-left: 1px solid var(--border-3);"
  >
    <div class="flex items-center justify-between px-5 py-4 border-b" style="border-color: var(--border-2);">
      <span class="font-semibold tracking-tight text-sm" style="color: var(--fg);" data-i18n="nav.menu">Menu</span>
      <button
        type="button"
        data-mobile-close
        aria-label="Close menu"
        data-i18n-aria-label="nav.closeMenu"
        class="inline-grid place-items-center w-11 h-11 rounded-full"
        style="background: var(--surface-strong); border: 1px solid var(--border-3); color: var(--fg);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 py-4">
      <ul class="space-y-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              data-mobile-link
              class="flex items-center justify-between gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-colors"
              style="color: var(--fg);"
            >
              <span data-i18n={l.key}>{l.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" class="opacity-40">
                <path d="M9 6l6 6-6 6"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>

    </nav>

    <div class="px-5 py-4 border-t flex items-center gap-2" style="border-color: var(--border-2);">
      {/* Mirrored toggles for sub-sm widths where they're hidden in the
          header. Visible on every drawer width — duplication on sm+ is
          harmless (the user typically doesn't open the drawer on sm+). */}
      <div class="sm:hidden flex items-center gap-2 mr-1">
        <LocaleToggle />
        <ThemeToggle />
      </div>
      <a
        href="#cta"
        data-mobile-link
        class="btn-primary flex-1 text-base"
      >
        <span data-i18n="hero.cta.demo">Request a tailored demo</span>
        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* Drawer states — drive transitions via a single parent class. */
  [data-mobile-panel] {
    /* Critical: the drawer is parked off-screen at translate-x-full.
       Without overflow:hidden here, the off-screen drawer makes
       the page horizontally scrollable on iOS Safari. */
    overflow: hidden;
  }
  [data-mobile-panel].is-open                          { pointer-events: auto; }
  [data-mobile-panel].is-open [data-mobile-backdrop]   { opacity: 1; }
  [data-mobile-panel].is-open [data-mobile-drawer]     { transform: translateX(0); }
  [data-mobile-panel] [data-mobile-link]:hover         { background: var(--surface-elev); }

  /* Shrunk nav state — past 200px scroll. Tighter padding + margin and
     a slightly smaller logo. Animated by the parent's transition utility. */
  [data-nav-bar].is-shrunk {
    margin-top: 0.5rem;          /* was mt-4 = 1rem */
    padding-top: 0.5rem;          /* was py-3 = 0.75rem */
    padding-bottom: 0.5rem;
  }
  [data-nav-bar].is-shrunk img {
    height: 18px;                 /* was 22px */
  }
</style>

<script>
  // Nav scroll tint + theme tracking + shrink-on-scroll.
  // Past ~200px the bar tightens its padding/margin and the logo nudges
  // smaller, the way Apple's nav does — gives a quiet sense the page has
  // travelled without snapping or jumping.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const bar = document.querySelector<HTMLElement>('[data-nav-bar]');
  const tintFor = () => {
    const theme = document.documentElement.getAttribute('data-theme');
    return theme === 'light'
      ? 'linear-gradient(180deg, rgba(246,245,255,0.7), rgba(246,245,255,0))'
      : 'linear-gradient(180deg, rgba(8,6,26,0.5), rgba(8,6,26,0))';
  };
  // rAF-coalesced scroll handler. Original ran a style mutation + a
  // classList toggle on every scroll tick — on 120Hz trackpads that's
  // 120 layout-flush opportunities per second. Coalescing into one rAF
  // per frame keeps the read/write atomic and bails when nothing changed.
  let navScrollFrame = 0;
  let navWasShrunk = false;
  let navHadTint = false;
  const updateNav = () => {
    navScrollFrame = 0;
    if (!nav) return;
    const tinted = window.scrollY > 12;
    if (tinted !== navHadTint) {
      nav.style.background = tinted ? tintFor() : 'transparent';
      navHadTint = tinted;
    }
    if (bar) {
      const shrunk = window.scrollY > 200;
      if (shrunk !== navWasShrunk) {
        bar.classList.toggle('is-shrunk', shrunk);
        navWasShrunk = shrunk;
      }
    }
  };
  const requestNav = () => {
    if (!navScrollFrame) navScrollFrame = requestAnimationFrame(updateNav);
  };
  // Initial paint without rAF; the rest go through rAF.
  updateNav();
  window.addEventListener('scroll', requestNav, { passive: true });
  // Theme switch updates the tint gradient. Force the cached state to
  // false so the next call re-applies the new tint color.
  new MutationObserver(() => { navHadTint = false; requestNav(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Mobile drawer
  const panel    = document.querySelector<HTMLElement>('[data-mobile-panel]');
  const toggle   = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const backdrop = document.querySelector<HTMLElement>('[data-mobile-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-close]');
  const drawer   = document.querySelector<HTMLElement>('[data-mobile-drawer]');
  const links    = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  // Track which element opened the drawer so we can return focus there
  // when it closes — required by APG for keyboard accessibility.
  let lastFocused: HTMLElement | null = null;

  // Focus-trap: when Tab/Shift+Tab would leave the drawer, wrap to the
  // other end. Without this, focus escapes into the (still-rendered)
  // page behind the backdrop.
  const trapFocus = (e: KeyboardEvent) => {
    if (e.key !== 'Tab' || !panel?.classList.contains('is-open') || !drawer) return;
    const focusable = drawer.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    if (!focusable.length) return;
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  };

  const setOpen = (open: boolean) => {
    if (!panel || !toggle) return;
    panel.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    // `inert` is the modern equivalent of disabling all interactive
    // descendants — removes them from tab order and pointer events.
    if (open) panel.removeAttribute('inert');
    else      panel.setAttribute('inert', '');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.style.overflow = open ? 'hidden' : '';
    const openIcon  = toggle.querySelector('[data-icon="open"]');
    const closeIcon = toggle.querySelector('[data-icon="close"]');
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);

    if (open) {
      lastFocused = document.activeElement as HTMLElement | null;
      // Move focus into the drawer so screen readers + keyboard users
      // start at the close button rather than wherever they were.
      requestAnimationFrame(() => closeBtn?.focus());
    } else {
      // Return focus to the trigger if focus is still inside the drawer.
      if (drawer?.contains(document.activeElement)) {
        (lastFocused ?? toggle)?.focus();
      }
    }
  };

  toggle?.addEventListener('click', () => setOpen(!panel?.classList.contains('is-open')));
  backdrop?.addEventListener('click', () => setOpen(false));
  closeBtn?.addEventListener('click', () => setOpen(false));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
    trapFocus(e);
  });
</script>
