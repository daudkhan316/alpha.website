---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#modules', label: 'Modules' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#ai', label: 'AI' },
  { href: '#use-cases', label: 'Use cases' },
  { href: '#architecture', label: 'Architecture' },
];
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
  data-nav
>
  <div class="container-wide">
    <nav class="mt-4 flex items-center justify-between rounded-full px-4 lg:px-6 py-3 glass">
      <a href="/" class="flex items-center gap-3 group" aria-label="Klaus — Alpha Platform home">
        <img
          src="/klaus-logo-white.svg"
          alt="Klaus"
          width="84" height="26"
          class="show-on-dark h-[22px] w-auto select-none"
          loading="eager"
          decoding="async"
        />
        <img
          src="/klaus-logo-color.svg"
          alt="Klaus"
          width="84" height="26"
          class="show-on-light h-[22px] w-auto select-none"
          loading="eager"
          decoding="async"
        />
        <span class="hidden sm:inline-block w-px h-5 bg-white/15"></span>
        <span class="hidden sm:inline font-semibold tracking-tight text-white text-sm">Alpha Platform</span>
      </a>

      <div class="hidden lg:flex items-center gap-1">
        {links.map((l) => (
          <a
            href={l.href}
            class="px-3 py-1.5 rounded-full text-sm text-white/70 hover:text-white hover:bg-white/5 transition-colors"
          >
            {l.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <a href="#cta" class="hidden sm:inline-flex text-sm text-white/70 hover:text-white px-3 py-1.5 transition-colors">Documentation</a>
        <ThemeToggle />
        <a href="#cta" class="btn-primary text-sm py-2 px-4">Request demo</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const tintFor = () => {
    const theme = document.documentElement.getAttribute('data-theme');
    return theme === 'light'
      ? 'linear-gradient(180deg, rgba(246,245,255,0.7), rgba(246,245,255,0))'
      : 'linear-gradient(180deg, rgba(8,6,26,0.5), rgba(8,6,26,0))';
  };
  const onScroll = () => {
    if (!nav) return;
    nav.style.background = window.scrollY > 12 ? tintFor() : 'transparent';
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  // Also re-tint when the user toggles theme.
  new MutationObserver(onScroll).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
