---
// Each link carries a stable i18n key in addition to the EN fallback label so
// the runtime can swap text without re-fetching the page.
const cols = [
  {
    titleKey: 'footer.col.platform',
    title: 'Platform',
    links: [
      { key: 'nav.modules',      label: 'Modules',           href: '#modules' },
      { key: 'nav.howItWorks',   label: 'How it works',      href: '#how-it-works' },
      { key: 'nav.capabilities', label: 'Capabilities',      href: '#capabilities' },
      { key: 'modules.m.CB.name', label: 'Cognitive Backend', href: '#ai' },
    ],
  },
  {
    titleKey: 'footer.col.trust',
    title: 'Trust',
    links: [
      { key: 'nav.architecture', label: 'Architecture', href: '#architecture' },
      { key: 'nav.useCases',     label: 'Use cases',    href: '#use-cases' },
      { key: 'footer.imprint',   label: 'Impressum',    href: '/impressum' },
      { key: 'footer.privacy',   label: 'Datenschutz',  href: '/datenschutz' },
    ],
  },
  {
    titleKey: 'footer.col.contact',
    title: 'Contact',
    links: [
      { key: 'nav.requestDemo', label: 'Request demo',              href: '#cta' },
      { key: null,              label: 'hello@alpha-platform.de',   href: 'mailto:hello@alpha-platform.de' },
    ],
  },
];
---

<footer class="relative pt-24 pb-10 border-t border-white/5">
  <div class="container-wide">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-10">
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center gap-3 mb-5" aria-label="Klaus — Alpha Platform home">
          <img
            src="/klaus-logo-white.svg"
            alt="Klaus"
            width="100" height="30"
            class="show-on-dark h-[26px] w-auto select-none"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/klaus-logo-color.svg"
            alt="Klaus"
            width="100" height="30"
            class="show-on-light h-[26px] w-auto select-none"
            loading="lazy"
            decoding="async"
          />
          <span class="w-px h-6 bg-white/15"></span>
          <span class="font-semibold tracking-tight text-base text-white">Alpha Platform</span>
        </a>
        <p class="text-sm text-white/55 max-w-sm leading-relaxed" data-i18n="footer.tagline">
          Enterprise insurance distribution platform from Klaus.
          Modular monolith. Configuration-driven. Hosted in Microsoft Azure Germany (Frankfurt).
        </p>
        <div class="mt-6 flex flex-wrap gap-1.5">
          {['ISO 27001', 'ISO 27701', 'SOC 2', 'GDPR', 'eIDAS', 'IDD'].map((c) => (
            <span class="text-[10px] tracking-wider uppercase font-medium px-2 py-1 rounded-md bg-white/[0.04] border border-white/10 text-white/60">{c}</span>
          ))}
        </div>
      </div>

      {cols.map((col) => (
        <div>
          <h4 class="text-xs uppercase tracking-[0.16em] text-white/40 mb-4" data-i18n={col.titleKey}>{col.title}</h4>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-white/70 hover:text-white transition-colors">
                  {l.key ? <span data-i18n={l.key}>{l.label}</span> : l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/40">
        <span data-i18n="footer.copyright">© {new Date().getFullYear()} Alpha Platform. All rights reserved.</span>
        <a href="/impressum" class="hover:text-white transition-colors" data-i18n="footer.imprint">Impressum</a>
        <a href="/datenschutz" class="hover:text-white transition-colors" data-i18n="footer.privacy">Datenschutz</a>
      </div>
      <p class="text-xs text-white/40 font-mono" data-i18n="footer.region">Region · Azure Germany West Central · Frankfurt</p>
    </div>
  </div>
</footer>
