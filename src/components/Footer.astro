---
const cols = [
  {
    title: 'Platform',
    links: [
      { label: 'Modules', href: '#modules' },
      { label: 'How it works', href: '#how-it-works' },
      { label: 'Capabilities', href: '#capabilities' },
      { label: 'Cognitive Backend', href: '#ai' },
    ],
  },
  {
    title: 'Solutions',
    links: [
      { label: 'For brokers', href: '#use-cases' },
      { label: 'For agencies', href: '#use-cases' },
      { label: 'For insurers', href: '#use-cases' },
      { label: 'Customer portal', href: '#use-cases' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { label: 'Architecture', href: '#architecture' },
      { label: 'Security & compliance', href: '#architecture' },
      { label: 'Deployment models', href: '#architecture' },
      { label: 'Data residency', href: '#architecture' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Request demo', href: '#cta' },
      { label: 'Talk to architect', href: '#cta' },
      { label: 'Documentation', href: '#cta' },
      { label: 'Partner program', href: '#cta' },
    ],
  },
];
---

<footer class="relative pt-24 pb-10 border-t border-white/5">
  <div class="container-wide">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-10">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-5">
          <span class="relative inline-block w-8 h-8 rounded-md bg-alpha-gradient shadow-glow-violet">
            <span class="absolute inset-0 grid place-items-center text-white font-bold text-base leading-none">α</span>
          </span>
          <span class="font-semibold tracking-tight text-lg text-white">Alpha Platform</span>
        </a>
        <p class="text-sm text-white/55 max-w-sm leading-relaxed">
          Enterprise insurance distribution platform.
          Modular monolith. Configuration-driven. Hosted in Microsoft Azure Germany (Frankfurt).
        </p>
        <div class="mt-6 flex flex-wrap gap-1.5">
          {['ISO 27001', 'ISO 27701', 'SOC 2', 'GDPR', 'eIDAS', 'IDD'].map((c) => (
            <span class="text-[10px] tracking-wider uppercase font-medium px-2 py-1 rounded-md bg-white/[0.04] border border-white/10 text-white/60">{c}</span>
          ))}
        </div>
      </div>

      {cols.map((col) => (
        <div>
          <h4 class="text-xs uppercase tracking-[0.16em] text-white/40 mb-4">{col.title}</h4>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-sm text-white/70 hover:text-white transition-colors">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
      <p class="text-xs text-white/40">© {new Date().getFullYear()} Alpha Platform. All rights reserved.</p>
      <p class="text-xs text-white/40 font-mono">Region · Azure Germany West Central · Frankfurt</p>
    </div>
  </div>
</footer>
