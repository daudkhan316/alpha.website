---
// Only entries with real, distinct anchors. The earlier 4-column footer had
// duplicate links (e.g. four "Solutions" entries all pointing at #use-cases,
// four "Trust" entries all pointing at #architecture) and dead anchors to
// /docs / /partner-program that don't exist.
const cols = [
  {
    title: 'Platform',
    links: [
      { label: 'Modules',           href: '#modules' },
      { label: 'How it works',      href: '#how-it-works' },
      { label: 'Capabilities',      href: '#capabilities' },
      { label: 'Cognitive Backend', href: '#ai' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { label: 'Architecture', href: '#architecture' },
      { label: 'Use cases',    href: '#use-cases' },
      { label: 'Impressum',    href: '/impressum' },
      { label: 'Datenschutz',  href: '/datenschutz' },
    ],
  },
  {
    title: 'Contact',
    links: [
      { label: 'Request demo',    href: '#cta' },
      { label: 'hello@alpha-platform.de', href: 'mailto:hello@alpha-platform.de' },
    ],
  },
];
---

<footer class="relative pt-24 pb-10 border-t border-white/5">
  <div class="container-wide">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-10">
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center gap-3 mb-5" aria-label="Klaus — Alpha Platform home">
          <img
            src="/klaus-logo-white.svg"
            alt="Klaus"
            width="100" height="30"
            class="show-on-dark h-[26px] w-auto select-none"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/klaus-logo-color.svg"
            alt="Klaus"
            width="100" height="30"
            class="show-on-light h-[26px] w-auto select-none"
            loading="lazy"
            decoding="async"
          />
          <span class="w-px h-6 bg-white/15"></span>
          <span class="font-semibold tracking-tight text-base text-white">Alpha Platform</span>
        </a>
        <p class="text-sm text-white/55 max-w-sm leading-relaxed">
          Enterprise insurance distribution platform from Klaus.
          Modular monolith. Configuration-driven. Hosted in Microsoft Azure Germany (Frankfurt).
        </p>
        <div class="mt-6 flex flex-wrap gap-1.5">
          {['ISO 27001', 'ISO 27701', 'SOC 2', 'GDPR', 'eIDAS', 'IDD'].map((c) => (
            <span class="text-[10px] tracking-wider uppercase font-medium px-2 py-1 rounded-md bg-white/[0.04] border border-white/10 text-white/60">{c}</span>
          ))}
        </div>
      </div>

      {cols.map((col) => (
        <div>
          <h4 class="text-xs uppercase tracking-[0.16em] text-white/40 mb-4">{col.title}</h4>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-sm text-white/70 hover:text-white transition-colors">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/40">
        <span data-i18n="footer.copyright">© {new Date().getFullYear()} Alpha Platform. All rights reserved.</span>
        <a href="/impressum" class="hover:text-white transition-colors" data-i18n="footer.imprint">Impressum</a>
        <a href="/datenschutz" class="hover:text-white transition-colors" data-i18n="footer.privacy">Datenschutz</a>
      </div>
      <p class="text-xs text-white/40 font-mono" data-i18n="footer.region">Region · Azure Germany West Central · Frankfurt</p>
    </div>
  </div>
</footer>
