---
// Only links with a real destination remain. The previous "Talk to a solutions
// architect", "Partner documentation", and "Security whitepaper" entries all
// pointed at #cta — self-referential dead links — and have been removed until
// real targets exist.
const secondary = [
  { label: 'Talk to a solutions architect', href: 'mailto:hello@alpha-platform.de' },
  { label: 'Compare deployment models',     href: '#architecture' },
];
---

<section id="cta" class="relative py-32 lg:py-40 overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid opacity-30 mask-fade-radial"></div>
    <div class="blob blob-violet w-[600px] h-[600px] -top-20 left-1/3 opacity-60" data-parallax="0.18"></div>
    <div class="blob blob-pink w-[500px] h-[500px] bottom-[-160px] right-1/3 opacity-60" data-parallax="0.14"></div>
  </div>

  <div class="container-narrow">
    <div class="reveal relative rounded-[28px] p-[1.5px] bg-alpha-gradient overflow-hidden" data-reveal="scale">
      <div class="relative rounded-[26px] bg-alpha-ink/95 px-8 sm:px-14 py-14 sm:py-20 text-center">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[80%] h-64 bg-alpha-purple/30 blur-3xl rounded-full pointer-events-none"></div>

        <p class="section-eyebrow" data-i18n="cta.eyebrow">See Alpha in action</p>
        <h2 class="section-heading mt-3 max-w-3xl mx-auto text-balance">
          <span data-i18n="cta.heading.a">One platform for the</span>
          <span class="gradient-text" data-i18n="cta.heading.b">whole insurance business.</span>
        </h2>
        <p class="mt-5 text-lg text-white/65 max-w-2xl mx-auto leading-relaxed" data-i18n="cta.body">
          Request a tailored demo. We'll show you the lifecycle that fits your business — from your first lead to your seven-year audit trail.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a href="mailto:hello@alpha-platform.de" class="btn-primary pulse-once text-base" data-magnet>
            <span data-i18n="cta.primary">Request a tailored demo</span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#architecture" class="btn-secondary text-base" data-i18n="cta.viewArch">View architecture</a>
        </div>

        <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {secondary.map((s, i) => (
            <li>
              <a class="text-sm text-white/60 hover:text-white transition-colors inline-flex items-center gap-1.5" href={s.href}>
                <span data-i18n={`cta.secondary.${i}`}>{s.label}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-12 pt-8 border-t border-white/10 text-xs text-white/60" data-i18n="cta.reassurance">
          Hosted exclusively in Microsoft Azure Germany (Frankfurt).
          ISO 27001 · ISO 27701 · SOC 2 · GDPR · eIDAS · IDD.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Magnetic pull on [data-magnet] buttons. While the pointer is within
  // a halo radius of the button, the button translates toward the
  // pointer by a small fraction of the offset — feels like the button
  // is "reaching" for the cursor. CSS transition is suppressed via
  // .is-pulling so the translation tracks the cursor without lag;
  // when the pointer leaves the halo, .is-pulling is removed and the
  // button eases back to rest over --t-short. One global pointermove
  // handler, rAF-throttled. Reduced-motion bails entirely.
  const wireMagnet = () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    const btns = Array.from(document.querySelectorAll<HTMLElement>('[data-magnet]'));
    if (!btns.length) return;
    const radius = 80;
    const strength = 0.18;
    let frame = 0;
    let pending: HTMLElement | null = null;
    let px = 0, py = 0;
    const flush = () => {
      frame = 0;
      if (!pending) return;
      pending.style.setProperty('--mag-x', px + 'px');
      pending.style.setProperty('--mag-y', py + 'px');
    };
    document.addEventListener('pointermove', (e) => {
      for (const btn of btns) {
        const r = btn.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        if (Math.hypot(dx, dy) <= radius) {
          btn.classList.add('is-pulling');
          pending = btn;
          px = dx * strength;
          py = dy * strength;
          if (!frame) frame = requestAnimationFrame(flush);
        } else if (btn.classList.contains('is-pulling')) {
          btn.classList.remove('is-pulling');
          btn.style.removeProperty('--mag-x');
          btn.style.removeProperty('--mag-y');
        }
      }
    }, { passive: true });
  };
  wireMagnet();
  document.addEventListener('astro:page-load', wireMagnet);
</script>
