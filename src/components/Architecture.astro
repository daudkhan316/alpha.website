---
const stack = [
  { layer: 'Backend',     items: ['Java 21', 'Spring Boot 3.5', 'Hibernate 6 + Envers', 'Spring Batch', 'PostgreSQL 16', 'Flyway · 300+ migrations'] },
  { layer: 'Frontend',    items: ['Angular 20.3 + PrimeNG', 'Customer portal · Angular 17.2', 'AI portal · Next.js 16 + React 19', 'Node.js gateway'] },
  { layer: 'Infrastructure', items: ['Microsoft Azure', 'Container Apps · 4 CPU / 8 GB', 'Container Registry', 'Service Bus · Key Vault', 'Region · Germany West Central'] },
  { layer: 'AI & Documents', items: ['Azure OpenAI · GPT-4o', 'Azure AI Document Intelligence', 'RAG over entity & attribute docs', 'Apache PDFBox · openhtmltopdf'] },
];

const pillars = [
  { kpi: '7-year', label: 'field-level audit retention', body: 'Hibernate Envers captures every change automatically — user, timestamp, before, after.' },
  { kpi: 'Per-tenant', label: 'PostgreSQL database', body: 'Optionally fully dedicated compute and Azure VNet — for the highest data sovereignty.' },
  { kpi: 'Frankfurt', label: 'Azure Germany West Central', body: 'EU data residency by default. No partner-specific code crosses tenant boundaries.' },
  { kpi: '5-level', label: 'RBAC permission model', body: 'Module → Feature → Object Type → Customer → Contract. Pre-computed access indices.' },
];

const compliance = ['ISO 27001', 'ISO 27701', 'SOC 2', 'GDPR · DSGVO', 'eIDAS · AES', 'IDD'];
---

<section id="architecture" class="section">
  <div class="absolute inset-0 -z-10 bg-grid opacity-25 mask-fade-bottom"></div>
  <div class="blob blob-purple w-[480px] h-[480px] -bottom-20 right-[-160px] opacity-50" data-parallax="0.18"></div>

  <div class="container-wide">
    <div class="grid lg:grid-cols-[1.05fr_1fr] gap-14 items-end">
      <div class="reveal">
        <p class="section-eyebrow" data-i18n="arch.eyebrow">Architecture · Trust</p>
        <h2 class="section-heading mt-3">
          <span data-i18n="arch.heading.a">Engineered for</span>
          <span class="gradient-text" data-i18n="arch.heading.b">regulated insurance.</span>
        </h2>
        <p class="mt-5 text-lg text-white/65 leading-relaxed max-w-2xl" data-i18n="arch.body">
          Alpha is a modular monolith — clean module boundaries, layered per module, metadata-driven UI,
          database-per-tenant multi-tenancy with optional dedicated compute, event-driven internally.
          Hosted exclusively in Microsoft Azure Germany.
        </p>
      </div>
      <div class="reveal flex flex-wrap gap-2 lg:justify-end">
        {compliance.map((c) => (
          <span class="px-3 py-2 rounded-lg bg-white/[0.03] border border-white/10 text-sm text-white/80 font-medium">
            {c}
          </span>
        ))}
      </div>
    </div>

    {/* Pillars — KPIs that lead with a digit (7-year, 5-level) opt into
        the global count-up runtime in Layout.astro via data-count. The
        regex there parses leading integer + suffix from textContent
        after i18n applies, so the suffix follows the active locale. */}
    <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-4 gap-5" data-stagger data-stagger-step="60">
      {pillars.map((p, i) => (
        <div class="reveal spotlight relative rounded-2xl glass p-6 overflow-hidden transition-transform duration-[var(--t-short)] ease-[var(--ease-soft)] hover:-translate-y-0.5">
          <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full bg-alpha-purple/20 blur-2xl"></div>
          <div class="relative">
            <div
              class="font-display text-3xl font-semibold tracking-tight gradient-text-strong"
              data-i18n={`arch.pillar.${i}.kpi`}
              data-count={/^\d/.test(p.kpi) ? '1' : undefined}
              data-count-duration="1100"
            >{p.kpi}</div>
            <div class="mt-1 text-xs text-white/50 uppercase tracking-[0.16em]" data-i18n={`arch.pillar.${i}.label`}>{p.label}</div>
            <div class="mt-4 text-sm text-white/65 leading-relaxed" data-i18n={`arch.pillar.${i}.body`}>{p.body}</div>
          </div>
        </div>
      ))}
    </div>

    {/* Stack & multi-tenancy diagram */}
    <div class="mt-16 grid lg:grid-cols-[1.2fr_1fr] gap-8 items-stretch">
      {/* Tech stack */}
      <div class="reveal glass-strong rounded-2xl p-6 lg:p-8">
        <div class="flex items-baseline justify-between">
          <h3 class="text-xl font-semibold tracking-tight" data-i18n="arch.stack.title">Technology stack</h3>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/40" data-i18n="arch.stack.production">production</span>
        </div>
        <div class="mt-6 grid sm:grid-cols-2 gap-x-8 gap-y-6">
          {stack.map((s) => {
            const layerKey =
              s.layer === 'Backend' ? 'arch.stack.backend' :
              s.layer === 'Frontend' ? 'arch.stack.frontend' :
              s.layer === 'Infrastructure' ? 'arch.stack.infra' :
              'arch.stack.aiDocs';
            return (
              <div>
                <div class="flex items-center gap-2 mb-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-alpha-pink"></span>
                  <h4 class="text-sm font-mono uppercase tracking-[0.16em] text-white/55" data-i18n={layerKey}>{s.layer}</h4>
                </div>
                <ul class="space-y-1.5">
                  {s.items.map((i) => (
                    <li class="text-sm text-white/80">— {i}</li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </div>

      {/* Multi-tenancy diagram */}
      <div class="reveal relative rounded-2xl p-[1px] bg-gradient-to-br from-violet-500/30 to-fuchsia-500/20">
        <div class="panel-dark-strong rounded-2xl p-6 lg:p-8 h-full flex flex-col">
          <div class="flex items-baseline justify-between">
            <h3 class="text-xl font-semibold tracking-tight" data-i18n="arch.deploy.title">Two deployment models</h3>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/40" data-i18n="arch.deploy.isolation">isolation</span>
          </div>

          {/* One-shot tier pulse choreography: when this card .reveals,
              the shared T1..T4 row pulses TOGETHER (single runtime, all
              tenants ride along), then the dedicated tenants pulse
              INDEPENDENTLY (own runtime, own DB) with a beat between
              T-A and T-B. The motion is the model: shared = one breath,
              dedicated = two breaths. Pulses run once each — no
              perpetual ambient loop. */}
          <div class="mt-6 flex-1 grid grid-rows-2 gap-4">
            {/* Shared compute */}
            <div class="rounded-xl border border-white/10 p-4">
              <div class="text-[11px] font-mono uppercase tracking-wider text-white/45 mb-3" data-i18n="arch.deploy.shared">Shared compute · DB per tenant</div>
              <div class="flex items-center gap-2">
                <div class="flex-1 px-3 py-2.5 rounded-lg bg-alpha-gradient text-white text-xs font-medium text-center" data-i18n="arch.deploy.runtime">Alpha runtime</div>
              </div>
              <div class="mt-2 grid grid-cols-4 gap-1.5">
                {['T1', 'T2', 'T3', 'T4'].map((t) => (
                  <div class="arch-tier-shared px-2 py-2 rounded-md bg-white/[0.04] border border-white/10 text-center font-mono text-[10px] text-white/70">{t} · pg</div>
                ))}
              </div>
            </div>

            {/* Dedicated */}
            <div class="rounded-xl border border-white/10 p-4">
              <div class="text-[11px] font-mono uppercase tracking-wider text-white/45 mb-3" data-i18n="arch.deploy.dedicated">Dedicated · own runtime + own DB</div>
              <div class="grid grid-cols-2 gap-2">
                {['T-A', 'T-B'].map((t, k) => (
                  <div class={`arch-tier-dedicated arch-tier-d-${k} rounded-md bg-white/[0.03] border border-white/10 p-2`}>
                    <div class="px-2 py-1.5 rounded bg-alpha-gradient text-white text-[10px] font-medium text-center">{t} · runtime</div>
                    <div class="mt-1 px-2 py-1.5 rounded bg-white/[0.04] border border-white/10 text-center font-mono text-[10px] text-white/70">{t} · pg</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
