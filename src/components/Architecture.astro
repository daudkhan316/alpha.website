  .arch-deploy {
    position: relative;
    border-radius: 1.5rem;
    padding: 1px;
    background: linear-gradient(135deg, rgba(102,126,234,0.32), rgba(240,147,251,0.24));
  }
  .arch-deploy-frame {
    border-radius: calc(1.5rem - 1px);
    background:
      radial-gradient(800px 320px at 0% 0%, rgba(102,126,234,0.10), transparent 60%),
      radial-gradient(800px 320px at 100% 100%, rgba(240,147,251,0.08), transparent 60%),
      rgba(8,6,26,0.94);
    padding: 1.75rem;
  }
  @media (min-width: 1024px) {
    .arch-deploy-frame { padding: 2.25rem; }
  }
  .arch-deploy-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .arch-deploy-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 4px;
    border-radius: 0.85rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.10);
  }
  .arch-deploy-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.95rem;
    border-radius: 0.65rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: rgba(255,255,255,0.62);
    cursor: pointer;
    transition: color var(--t-short) var(--ease-soft),
                background var(--t-short) var(--ease-soft);
  }
  .arch-deploy-tab:hover { color: rgba(255,255,255,0.9); }
  .arch-deploy-tab.is-active {
    color: #fff;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 55%, #f093fb 100%);
    box-shadow:
      0 6px 22px -6px rgba(118,75,162,0.65),
      inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .arch-deploy-tab-glyph {
    display: inline-grid;
    place-items: center;
    width: 22px; height: 22px;
    border-radius: 6px;
    background: rgba(0,0,0,0.18);
  }
  .arch-deploy-tab.is-active .arch-deploy-tab-glyph { background: rgba(255,255,255,0.18); }

  /* ── Diagram stage ─────────────────────────────────────────
     Locked to a fixed 600:360 aspect ratio so SVG paths (in viewBox
     coords) and HTML nodes (in % of the box) share ONE coordinate
     space. Without this, `preserveAspectRatio="xMidYMid meet"`
     letterboxes the SVG inside a wider container and the lines
     drift away from the nodes. */
  .arch-deploy-stage {
    position: relative;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 600 / 360;
    margin: 0 auto;
  }
  .ddiagram {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(13,10,43,0.5);
    overflow: hidden;
    transition: opacity var(--t-medium) var(--ease-soft),
                transform var(--t-medium) var(--ease-soft),
                filter var(--t-medium) var(--ease-soft);
  }
  .arch-deploy[data-deploy-mode='shared'] [data-pane='shared'],
  .arch-deploy[data-deploy-mode='dedicated'] [data-pane='dedicated'] {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
    pointer-events: auto;
  }
  .arch-deploy[data-deploy-mode='shared'] [data-pane='dedicated'],
  .arch-deploy[data-deploy-mode='dedicated'] [data-pane='shared'] {
    opacity: 0;
    transform: translateY(8px) scale(0.99);
    filter: blur(6px);
    pointer-events: none;
  }
  .ddiagram-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 30px 30px;
    background-position: -1px -1px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 50%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 50%, transparent 100%);
  }
  .ddiagram-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Wires */
  .dwire {
    fill: none;
    stroke: url(#dwireA);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
    stroke-linecap: round;
    animation: dwireDash 4s linear infinite;
    opacity: 0.85;
  }
  .dwire-A { stroke: rgba(167,139,250,0.85); }
  .dwire-B { stroke: rgba(240,147,251,0.85); }
  @keyframes dwireDash { to { stroke-dashoffset: -120; } }

  /* VNet boundary rectangles (dedicated mode) */
  .dvnet {
    fill: rgba(102,126,234,0.04);
    stroke: rgba(167,139,250,0.45);
    stroke-width: 1;
    stroke-dasharray: 6 4;
    animation: vnetDash 18s linear infinite;
  }
  .dvnet[style*="--vnet-i:1"] { stroke: rgba(240,147,251,0.45); fill: rgba(240,147,251,0.04); }
  @keyframes vnetDash { to { stroke-dashoffset: -200; } }
  .dvnet-label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgba(167,139,250,0.15);
    border: 1px solid rgba(167,139,250,0.4);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.85);
    z-index: 2;
  }
  .dvnet-label--b {
    background: rgba(240,147,251,0.15);
    border-color: rgba(240,147,251,0.4);
  }
  .dvnet-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
    color: #a78bfa;
    animation: trustBlink 1.6s ease-in-out infinite;
  }
  .dvnet-label--b .dvnet-dot { color: #f093fb; }

  /* Packet "head" glow */
  .dpacket {
    filter: drop-shadow(0 0 6px rgba(240,147,251,0.85));
  }

  /* Diagram nodes */
  .dnode {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.6rem;
    background: rgba(13,10,43,0.85);
    border: 1px solid rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.92);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    z-index: 2;
    box-shadow: 0 8px 22px -10px rgba(0,0,0,0.7);
    transition: transform var(--t-short) var(--ease-soft), border-color var(--t-short) var(--ease-soft);
  }
  .dnode-mini { padding: 0.4rem 0.7rem; font-size: 0.7rem; }
  .dnode-icon {
    display: inline-grid; place-items: center;
    width: 22px; height: 22px;
    border-radius: 5px;
    background: rgba(102,126,234,0.18);
    color: #c4b5fd;
    border: 1px solid rgba(102,126,234,0.4);
  }
  .dnode-icon--db {
    background: rgba(240,147,251,0.14);
    color: #f0abfc;
    border-color: rgba(240,147,251,0.4);
  }
  .dnode-text { font-weight: 500; }
  .dnode-meta {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.5);
  }

  /* Runtime node (centerpiece, with pulse halo) */
  .dnode-runtime {
    background: linear-gradient(135deg, rgba(102,126,234,0.22), rgba(240,147,251,0.18));
    border-color: rgba(240,147,251,0.45);
    padding: 0.7rem 1.2rem;
    font-weight: 600;
  }
  .dnode-runtime .dnode-text { color: #fff; }
  .dnode-runtime-pulse {
    position: absolute;
    inset: -6px;
    border-radius: inherit;
    border: 1px solid rgba(240,147,251,0.55);
    animation: rtPulse 2.4s ease-out infinite;
    pointer-events: none;
  }
  @keyframes rtPulse {
    0%   { transform: scale(0.96); opacity: 0.9; }
    100% { transform: scale(1.18); opacity: 0; }
  }
  .dnode-runtime--A { background: linear-gradient(135deg, rgba(102,126,234,0.28), rgba(167,139,250,0.22)); border-color: rgba(167,139,250,0.55); }
  .dnode-runtime--B { background: linear-gradient(135deg, rgba(167,139,250,0.22), rgba(240,147,251,0.28)); border-color: rgba(240,147,251,0.55); }

  /* DB "arrived" pulse — keyed off packet arrivals (CSS-only loop) */
  .dnode-db { font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.7rem; }
  .dnode-db::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: inherit;
    border: 1px solid rgba(240,147,251,0.45);
    opacity: 0;
    animation: dbHit 2.8s ease-out infinite;
  }
  .dnode-db-1::after { animation-delay: 0.0s; }
  .dnode-db-2::after { animation-delay: 0.7s; }
  .dnode-db-3::after { animation-delay: 1.4s; }
  .dnode-db-4::after { animation-delay: 2.1s; }
  .dnode-db--A::after { animation-delay: 0.9s; }
  .dnode-db--B::after { animation-delay: 0.6s; border-color: rgba(167,139,250,0.45); }
  @keyframes dbHit {
    0%, 70% { opacity: 0; transform: scale(1); }
    78%     { opacity: 0.9; transform: scale(1.05); }
    100%    { opacity: 0; transform: scale(1.18); }
  }

  /* Diagram corner tags */
  .ddiagram-tag {
    position: absolute;
    padding: 0.3rem 0.55rem;
    border-radius: 0.4rem;
    background: rgba(13,10,43,0.7);
    border: 1px solid rgba(255,255,255,0.10);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.55);
    z-index: 3;
  }
  .ddiagram-tag-tl { top: 12px; left: 12px; }
  .ddiagram-tag-tr { top: 12px; right: 12px; }

  /* Stat strip */
  .arch-deploy-stats {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }
  @media (min-width: 768px) {
    .arch-deploy-stats { grid-template-columns: repeat(4, 1fr); }
  }
  .arch-deploy-stat {
    padding: 0.7rem 0.85rem;
    border-radius: 0.65rem;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.10);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .arch-deploy-stat-k {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.45);
  }
  .arch-deploy-stat-v {
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
  }

  /* ─── Light theme tweaks ────────────────────────────── */
  :root[data-theme='light'] .arch-tech {
    background:
      radial-gradient(800px 320px at 0% 0%, rgba(102,126,234,0.10), transparent 60%),
      radial-gradient(800px 320px at 100% 100%, rgba(240,147,251,0.10), transparent 60%),
      rgba(13,10,43,0.04);
    border-color: rgba(15,18,35,0.10);
  }
  :root[data-theme='light'] .arch-schema-grid {
    background:
      linear-gradient(rgba(15,18,35,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,18,35,0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
    border-color: rgba(15,18,35,0.10);
  }
  :root[data-theme='light'] .arch-schema-chip { color: rgba(15,18,35,0.85); background: rgba(255,255,255,0.7); }
  :root[data-theme='light'] .arch-schema-layer { color: var(--fg-strong); }
  :root[data-theme='light'] .arch-trust { background: rgba(13,10,43,0.04); }
  :root[data-theme='light'] .arch-trust-name { color: rgba(15,18,35,0.92); }
  :root[data-theme='light'] .arch-trust-foot,
  :root[data-theme='light'] .arch-eyebrow { color: rgba(15,18,35,0.7); }
  :root[data-theme='light'] .arch-pillar-art { background: rgba(13,10,43,0.06); }

  /* "Two deployment models" — light theme.
     The frame, tabs, diagrams, nodes, tags and stat strip were all
     authored against a near-black canvas. Re-base each onto a paper
     surface with the same accent tint and flip the white text/borders
     to dark equivalents so contrast holds. */
  :root[data-theme='light'] .arch-deploy-frame {
    background:
      radial-gradient(800px 320px at 0% 0%, rgba(102,126,234,0.10), transparent 60%),
      radial-gradient(800px 320px at 100% 100%, rgba(240,147,251,0.08), transparent 60%),
      rgba(13,10,43,0.04);
  }
  :root[data-theme='light'] .arch-deploy-tabs {
    background: rgba(13,10,43,0.04);
    border-color: rgba(15,18,35,0.12);
  }
  :root[data-theme='light'] .arch-deploy-tab { color: rgba(15,18,35,0.65); }
  :root[data-theme='light'] .arch-deploy-tab:hover { color: rgba(15,18,35,0.92); }
  :root[data-theme='light'] .arch-deploy-tab.is-active { color: #fff; }
  :root[data-theme='light'] .arch-deploy-tab-glyph { background: rgba(15,18,35,0.06); }

  :root[data-theme='light'] .ddiagram {
    background: rgba(255,255,255,0.7);
    border-color: rgba(15,18,35,0.10);
  }
  :root[data-theme='light'] .ddiagram-grid {
    background:
      linear-gradient(rgba(15,18,35,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,18,35,0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    background-position: -1px -1px;
  }

  :root[data-theme='light'] .dvnet { fill: rgba(102,126,234,0.05); }
  :root[data-theme='light'] .dvnet[style*="--vnet-i:1"] { fill: rgba(240,147,251,0.05); }
  :root[data-theme='light'] .dvnet-label { color: rgba(15,18,35,0.85); }

  :root[data-theme='light'] .dnode {
    background: rgba(255,255,255,0.92);
    border-color: rgba(15,18,35,0.14);
    color: rgba(15,18,35,0.92);
    box-shadow: 0 8px 22px -12px rgba(15,18,35,0.25);
  }
  :root[data-theme='light'] .dnode-icon { color: #6d54d4; }
  :root[data-theme='light'] .dnode-icon--db { color: #c026d3; }
  :root[data-theme='light'] .dnode-meta { color: rgba(15,18,35,0.55); }

  :root[data-theme='light'] .dnode-runtime {
    background: linear-gradient(135deg, rgba(102,126,234,0.18), rgba(240,147,251,0.16));
  }
  :root[data-theme='light'] .dnode-runtime .dnode-text { color: rgba(15,18,35,0.92); }
  :root[data-theme='light'] .dnode-runtime--A {
    background: linear-gradient(135deg, rgba(102,126,234,0.20), rgba(167,139,250,0.16));
