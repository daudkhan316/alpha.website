---
type StackLayer = {
  id: string;
  layer: string;
  layerKey: string;
  accent: string;
  glyph: string;
  items: string[];
};

const stack: StackLayer[] = [
  {
    id: 'frontend',
    layer: 'Frontend',
    layerKey: 'arch.stack.frontend',
    accent: '#f093fb',
    glyph: 'M3 5h18v3H3zm0 5h18v3H3zm0 5h18v3H3z',
    items: ['Angular 20.3 + PrimeNG', 'Customer portal · Angular 17.2', 'AI portal · Next.js 16 + React 19', 'Node.js gateway'],
  },
  {
    id: 'backend',
    layer: 'Backend',
    layerKey: 'arch.stack.backend',
    accent: '#a78bfa',
    glyph: 'M4 6c0-1.1 3.6-2 8-2s8 .9 8 2v3c0 1.1-3.6 2-8 2s-8-.9-8-2V6zm0 6c0-1.1 3.6-2 8-2s8 .9 8 2v3c0 1.1-3.6 2-8 2s-8-.9-8-2v-3zm0 6c0-1.1 3.6-2 8-2s8 .9 8 2v3c0 1.1-3.6 2-8 2s-8-.9-8-2v-3z',
    items: ['Java 21', 'Spring Boot 3.5', 'Hibernate 6 + Envers', 'Spring Batch', 'PostgreSQL 16', 'Flyway · 300+ migrations'],
  },
  {
    id: 'ai',
    layer: 'AI & Documents',
    layerKey: 'arch.stack.aiDocs',
    accent: '#7dd3fc',
    glyph: 'M12 2l2.5 5.5L20 10l-5.5 2.5L12 18l-2.5-5.5L4 10l5.5-2.5z',
    items: ['Azure OpenAI · GPT-4o', 'Azure AI Document Intelligence', 'RAG over entity & attribute docs', 'Apache PDFBox · openhtmltopdf'],
  },
  {
    id: 'infra',
    layer: 'Infrastructure',
    layerKey: 'arch.stack.infra',
    accent: '#667eea',
    glyph: 'M4 4h7v7H4zm9 0h7v7h-7zM4 13h7v7H4zm9 0h7v7h-7z',
    items: ['Microsoft Azure', 'Container Apps · 4 CPU / 8 GB', 'Container Registry', 'Service Bus · Key Vault', 'Region · Germany West Central'],
  },
];

const pillars = [
  { kpi: '7-year', label: 'field-level audit retention', body: 'Hibernate Envers captures every change automatically — user, timestamp, before, after.' },
  { kpi: 'Per-tenant', label: 'PostgreSQL database', body: 'Optionally fully dedicated compute and Azure VNet — for the highest data sovereignty.' },
  { kpi: 'Frankfurt', label: 'Azure Germany West Central', body: 'EU data residency by default. No partner-specific code crosses tenant boundaries.' },
  { kpi: '5-level', label: 'RBAC permission model', body: 'Module → Feature → Object Type → Customer → Contract. Pre-computed access indices.' },
];

const compliance = ['ISO 27001', 'ISO 27701', 'SOC 2', 'GDPR · DSGVO', 'eIDAS · AES', 'IDD'];
---

<section id="architecture" class="section arch-section">
  <div class="absolute inset-0 -z-10 bg-grid opacity-25 mask-fade-bottom"></div>
  <div class="blob blob-purple w-[480px] h-[480px] -bottom-20 right-[-160px] opacity-50" data-parallax="0.18"></div>
  <div class="blob blob-violet w-[420px] h-[420px] -top-32 left-[-120px] opacity-40" data-parallax="0.12"></div>

  <div class="container-wide">
    {/* ─── HERO START · live header + animated trust panel ───────── */}
    <div class="arch-hero">
      <div class="arch-hero-text reveal">
        <p class="arch-eyebrow">
          <span class="arch-live-dot" aria-hidden="true"></span>
          <span data-i18n="arch.eyebrow">Architecture · Trust</span>
          <span class="arch-eyebrow-spacer" aria-hidden="true"></span>
          <span class="arch-eyebrow-id">DE-W-C · 99.99%</span>
        </p>
        <h2 class="section-heading mt-3">
          <span data-i18n="arch.heading.a">Engineered for</span>
          <span class="gradient-text" data-i18n="arch.heading.b">regulated insurance.</span>
        </h2>
        <p class="mt-5 text-lg text-white/65 leading-relaxed max-w-2xl" data-i18n="arch.body">
          Alpha is a modular monolith — clean module boundaries, layered per module, metadata-driven UI,
          database-per-tenant multi-tenancy with optional dedicated compute, event-driven internally.
          Hosted exclusively in Microsoft Azure Germany.
        </p>

        <div class="arch-meta-strip" aria-hidden="true">
          <div class="arch-meta-strip-track">
            <span>EU data residency</span><span>·</span>
            <span>Field-level audit</span><span>·</span>
            <span>Per-tenant DB</span><span>·</span>
            <span>VNet isolation</span><span>·</span>
            <span>Frankfurt</span><span>·</span>
            <span>EU data residency</span><span>·</span>
            <span>Field-level audit</span><span>·</span>
            <span>Per-tenant DB</span><span>·</span>
            <span>VNet isolation</span><span>·</span>
            <span>Frankfurt</span><span>·</span>
          </div>
        </div>
      </div>

      <aside class="arch-trust reveal" data-reveal="scale">
        <div class="arch-trust-head">
          <span class="arch-trust-eyebrow">compliance</span>
          <span class="arch-trust-live">
            <span class="arch-trust-live-dot" aria-hidden="true"></span>
            live
          </span>
        </div>
        <ul class="arch-trust-list">
          {compliance.map((c, i) => (
            <li class="arch-trust-item" style={`--i:${i};`}>
              <span class="arch-trust-name">{c}</span>
              <span class="arch-trust-bar" aria-hidden="true">
                <span class="arch-trust-bar-fill"></span>
              </span>
              <svg class="arch-trust-check" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path d="M5 12l4 4 10-10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
          ))}
        </ul>
        <div class="arch-trust-foot">
          <span>Audited continuously</span>
          <span class="arch-trust-foot-region">Azure DE-W-C</span>
        </div>
      </aside>
    </div>

    {/* ─── PILLARS · each card carries its own running mini-animation ─── */}
    <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-4 gap-5" data-stagger data-stagger-step="60">
      {pillars.map((p, i) => (
        <div class="reveal arch-pillar spotlight" data-pillar={i}>
          <div class="arch-pillar-glow"></div>

          {/* Per-pillar mini-graphic */}
          <div class="arch-pillar-art" aria-hidden="true">
            {i === 0 && (
              <div class="art-timeline">
                {Array.from({length: 7}).map((_, k) => (
                  <span class="art-timeline-bar" style={`--k:${k};`}></span>
                ))}
                <span class="art-timeline-cursor"></span>
              </div>
            )}
            {i === 1 && (
              <div class="art-tenants">
                {Array.from({length: 4}).map((_, k) => (
                  <span class="art-tenant-row" style={`--k:${k};`}>
                    <span class="art-tenant-pill"></span>
                    <span class="art-tenant-line"></span>
                    <span class="art-tenant-db"></span>
                  </span>
                ))}
              </div>
            )}
            {i === 2 && (
              <div class="art-radar">
                <span class="art-radar-ring art-radar-r1"></span>
                <span class="art-radar-ring art-radar-r2"></span>
                <span class="art-radar-ring art-radar-r3"></span>
                <span class="art-radar-dot"></span>
                <span class="art-radar-sweep"></span>
              </div>
            )}
            {i === 3 && (
              <div class="art-cascade">
                {['Module','Feature','Object','Customer','Contract'].map((label, k) => (
                  <span class="art-cascade-step" style={`--k:${k};`}>
                    <span class="art-cascade-dot"></span>
                    <span class="art-cascade-label">{label}</span>
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="relative">
            <div class="font-display text-3xl font-semibold tracking-tight gradient-text-strong" data-i18n={`arch.pillar.${i}.kpi`}>{p.kpi}</div>
            <div class="mt-1 text-xs text-white/50 uppercase tracking-[0.16em]" data-i18n={`arch.pillar.${i}.label`}>{p.label}</div>
            <div class="mt-4 text-sm text-white/65 leading-relaxed" data-i18n={`arch.pillar.${i}.body`}>{p.body}</div>
          </div>
        </div>
      ))}
    </div>

    {/* Tech-stack visualization */}
    <div class="mt-20 reveal arch-tech is-visible">
      <div class="arch-tech-head">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/45" data-i18n="arch.tech.eyebrow">live system map</span>
          <h3 class="mt-2 text-2xl lg:text-3xl font-semibold tracking-tight" data-i18n="arch.stack.title">Technology stack</h3>
          <p class="mt-2 text-sm text-white/60 max-w-xl" data-i18n="arch.tech.blurb.schema">
            A live schematic of how layers exchange traffic — pulses travel between connected components.
          </p>
        </div>
      </div>

      <div class="arch-schema">
        <div class="arch-schema-grid">
          {stack.map((s, i) => (
            <div
              class="arch-schema-row"
              data-schema-row={s.id}
              style={`--schema-accent:${s.accent}; --schema-i:${i};`}
            >
              <div class="arch-schema-rail">
                <div class="arch-schema-rail-pulse" aria-hidden="true"></div>
              </div>
              <div class="arch-schema-label">
                <div class="arch-schema-icon">
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path d={s.glyph} fill="currentColor"/>
                  </svg>
                </div>
                <div>
                  <div class="arch-schema-layer" data-i18n={s.layerKey}>{s.layer}</div>
                  <div class="arch-schema-meta">{s.items.length} components</div>
                </div>
              </div>
              <div class="arch-schema-chips">
                {s.items.map((item, j) => (
                  <button
                    type="button"
                    class="arch-schema-chip"
                    data-schema-chip
                    style={`--chip-j:${j};`}
                  >
                    <span class="arch-schema-chip-pin" aria-hidden="true"></span>
                    <span class="arch-schema-chip-text">{item}</span>
                    <span class="arch-schema-chip-bar" aria-hidden="true"></span>
                  </button>
                ))}
              </div>
            </div>
          ))}

          {/* Animated connection paths */}
          <svg class="arch-schema-wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="wireGrad" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0%" stop-color="rgba(102,126,234,0.0)"/>
                <stop offset="40%" stop-color="rgba(102,126,234,0.55)"/>
                <stop offset="60%" stop-color="rgba(240,147,251,0.55)"/>
                <stop offset="100%" stop-color="rgba(240,147,251,0.0)"/>
              </linearGradient>
            </defs>
            <path d="M2 12 C 30 12, 70 38, 98 38" class="arch-schema-wire" style="--wire-i:0"/>
            <path d="M2 38 C 30 38, 70 62, 98 62" class="arch-schema-wire" style="--wire-i:1"/>
            <path d="M2 62 C 30 62, 70 88, 98 88" class="arch-schema-wire" style="--wire-i:2"/>
            <path d="M2 88 C 30 88, 70 12, 98 12" class="arch-schema-wire" style="--wire-i:3"/>
          </svg>
        </div>
        <p class="arch-schema-hint" data-i18n="arch.tech.hint.schema">Each rail is one architectural layer · pulses indicate inter-layer traffic</p>
      </div>
    </div>

    {/* ─── DEPLOYMENT MODELS · animated, tabbed, packet-flow diagram ─── */}
    <div class="mt-12 reveal arch-deploy" data-deploy-mode="shared">
      <div class="arch-deploy-frame">
        <div class="arch-deploy-head">
          <div>
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/45" data-i18n="arch.deploy.isolation">isolation</span>
            <h3 class="mt-2 text-2xl lg:text-3xl font-semibold tracking-tight" data-i18n="arch.deploy.title">Two deployment models</h3>
            <p class="mt-2 text-sm text-white/60 max-w-xl" data-i18n="arch.deploy.blurb">
              Watch a request flow through both topologies — same product, two isolation levels.
            </p>
          </div>

          <div class="arch-deploy-tabs" role="tablist">
            <button type="button" class="arch-deploy-tab is-active" role="tab" aria-selected="true" data-mode="shared">
              <span class="arch-deploy-tab-glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="6" r="2.5" fill="currentColor"/><circle cx="5" cy="18" r="2" fill="currentColor"/><circle cx="12" cy="18" r="2" fill="currentColor"/><circle cx="19" cy="18" r="2" fill="currentColor"/><path d="M12 9v3M12 12L5 16M12 12l7 4" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
              </span>
              <span data-i18n="arch.deploy.shared">Shared compute · DB per tenant</span>
            </button>
            <button type="button" class="arch-deploy-tab" role="tab" aria-selected="false" data-mode="dedicated">
              <span class="arch-deploy-tab-glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14"><rect x="3" y="4" width="8" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="13" y="4" width="8" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="7" cy="9" r="1.4" fill="currentColor"/><circle cx="7" cy="15" r="1.4" fill="currentColor"/><circle cx="17" cy="9" r="1.4" fill="currentColor"/><circle cx="17" cy="15" r="1.4" fill="currentColor"/></svg>
              </span>
              <span data-i18n="arch.deploy.dedicated">Dedicated · own runtime + own DB</span>
            </button>
          </div>
        </div>

        <div class="arch-deploy-stage">
          {/* ─── Shared mode diagram ─── */}
          <div class="ddiagram ddiagram-shared" data-pane="shared">
            <div class="ddiagram-grid"></div>
            <svg class="ddiagram-svg" viewBox="0 0 600 360" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <defs>
                <linearGradient id="dwireA" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="rgba(102,126,234,0.55)"/>
                  <stop offset="100%" stop-color="rgba(240,147,251,0.55)"/>
                </linearGradient>
                <radialGradient id="dpacket" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#fff"/>
                  <stop offset="60%" stop-color="#f093fb"/>
                  <stop offset="100%" stop-color="rgba(240,147,251,0)"/>
                </radialGradient>
              </defs>

              {/* Connection paths (client → runtime → 4 DBs) */}
              <path id="psh-c" d="M 300 60 C 300 100, 300 120, 300 150" class="dwire" />
              <path id="psh-1" d="M 300 215 C 240 240, 160 260, 100 300" class="dwire" />
              <path id="psh-2" d="M 300 215 C 280 245, 240 270, 233 300" class="dwire" />
              <path id="psh-3" d="M 300 215 C 320 245, 360 270, 367 300" class="dwire" />
              <path id="psh-4" d="M 300 215 C 360 240, 440 260, 500 300" class="dwire" />

              {/* Traveling packets */}
              <circle r="4" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.6s" repeatCount="indefinite" rotate="auto"><mpath href="#psh-c"/></animateMotion></circle>
              <circle r="3.5" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.8s" begin="0.3s" repeatCount="indefinite"><mpath href="#psh-1"/></animateMotion></circle>
              <circle r="3.5" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.8s" begin="0.6s" repeatCount="indefinite"><mpath href="#psh-2"/></animateMotion></circle>
              <circle r="3.5" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.8s" begin="0.9s" repeatCount="indefinite"><mpath href="#psh-3"/></animateMotion></circle>
              <circle r="3.5" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.8s" begin="1.2s" repeatCount="indefinite"><mpath href="#psh-4"/></animateMotion></circle>
            </svg>

            {/* Nodes — positioned with % over the SVG (viewBox 600×360) */}
            <div class="dnode dnode-client" style="left:50%; top:8.33%;">
              <span class="dnode-icon">
                <svg viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </span>
              <span class="dnode-text">Client request</span>
              <span class="dnode-meta">https · jwt</span>
            </div>

            <div class="dnode dnode-runtime" style="left:50%; top:42.22%;" data-runtime>
              <span class="dnode-runtime-pulse" aria-hidden="true"></span>
              <span class="dnode-icon">
                <svg viewBox="0 0 24 24" width="16" height="16"><rect x="3" y="6" width="18" height="4" rx="1" fill="currentColor"/><rect x="3" y="14" width="18" height="4" rx="1" fill="currentColor" opacity="0.6"/></svg>
              </span>
              <span class="dnode-text">Alpha runtime</span>
              <span class="dnode-meta">shared · 4×8GB</span>
            </div>

            <div class="dnode dnode-db dnode-db-1" style="left:16.66%; top:83.88%;" data-db>
              <span class="dnode-icon dnode-icon--db"><svg viewBox="0 0 24 24" width="14" height="14"><ellipse cx="12" cy="6" rx="7" ry="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 6v6c0 1.5 3.1 2.5 7 2.5s7-1 7-2.5V6M5 12v6c0 1.5 3.1 2.5 7 2.5s7-1 7-2.5v-6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
              T1 · pg
            </div>
            <div class="dnode dnode-db dnode-db-2" style="left:38.83%; top:83.88%;" data-db>
              <span class="dnode-icon dnode-icon--db"><svg viewBox="0 0 24 24" width="14" height="14"><ellipse cx="12" cy="6" rx="7" ry="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 6v12c0 1.5 3.1 2.5 7 2.5s7-1 7-2.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
              T2 · pg
            </div>
            <div class="dnode dnode-db dnode-db-3" style="left:61.16%; top:83.88%;" data-db>
              <span class="dnode-icon dnode-icon--db"><svg viewBox="0 0 24 24" width="14" height="14"><ellipse cx="12" cy="6" rx="7" ry="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 6v12c0 1.5 3.1 2.5 7 2.5s7-1 7-2.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
              T3 · pg
            </div>
            <div class="dnode dnode-db dnode-db-4" style="left:83.33%; top:83.88%;" data-db>
              <span class="dnode-icon dnode-icon--db"><svg viewBox="0 0 24 24" width="14" height="14"><ellipse cx="12" cy="6" rx="7" ry="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 6v12c0 1.5 3.1 2.5 7 2.5s7-1 7-2.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
              T4 · pg
            </div>

            {/* Annotations */}
            <span class="ddiagram-tag ddiagram-tag-tl">1 runtime · 4 tenants</span>
            <span class="ddiagram-tag ddiagram-tag-tr">isolation: database boundary</span>
          </div>

          {/* ─── Dedicated mode diagram ─── */}
          <div class="ddiagram ddiagram-dedicated" data-pane="dedicated" aria-hidden="true">
            <div class="ddiagram-grid"></div>
            <svg class="ddiagram-svg" viewBox="0 0 600 360" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <defs>
                <radialGradient id="dpacket2" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0%" stop-color="#fff"/>
                  <stop offset="60%" stop-color="#a78bfa"/>
                  <stop offset="100%" stop-color="rgba(167,139,250,0)"/>
                </radialGradient>
              </defs>

              {/* VNet boundaries */}
              <rect x="20" y="40" width="260" height="290" rx="14" class="dvnet"/>
              <rect x="320" y="40" width="260" height="290" rx="14" class="dvnet" style="--vnet-i:1"/>

              {/* Tenant A connections */}
              <path id="pded-a1" d="M 150 90 C 150 130, 150 150, 150 180" class="dwire dwire-A"/>
              <path id="pded-a2" d="M 150 230 C 150 260, 150 280, 150 295" class="dwire dwire-A"/>
              {/* Tenant B connections */}
              <path id="pded-b1" d="M 450 90 C 450 130, 450 150, 450 180" class="dwire dwire-B"/>
              <path id="pded-b2" d="M 450 230 C 450 260, 450 280, 450 295" class="dwire dwire-B"/>

              {/* Packets */}
              <circle r="4" fill="url(#dpacket2)" class="dpacket"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#pded-a1"/></animateMotion></circle>
              <circle r="4" fill="url(#dpacket2)" class="dpacket"><animateMotion dur="2.6s" begin="0.6s" repeatCount="indefinite"><mpath href="#pded-a2"/></animateMotion></circle>
              <circle r="4" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.6s" begin="0.3s" repeatCount="indefinite"><mpath href="#pded-b1"/></animateMotion></circle>
              <circle r="4" fill="url(#dpacket)" class="dpacket"><animateMotion dur="2.6s" begin="0.9s" repeatCount="indefinite"><mpath href="#pded-b2"/></animateMotion></circle>
            </svg>

            {/* VNet labels */}
            <span class="dvnet-label" style="left:3.33%; top:5%;">
              <span class="dvnet-dot" aria-hidden="true"></span>
              VNet · Tenant A
            </span>
            <span class="dvnet-label dvnet-label--b" style="left:53.33%; top:5%;">
              <span class="dvnet-dot" aria-hidden="true"></span>
              VNet · Tenant B
            </span>

            {/* Tenant A nodes (left column) */}
            <div class="dnode dnode-client dnode-mini" style="left:25%; top:16.66%;">
              <span class="dnode-icon"><svg viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
              Client A
            </div>
            <div class="dnode dnode-runtime dnode-runtime--A" style="left:25%; top:50.55%;" data-runtime>
              <span class="dnode-runtime-pulse" aria-hidden="true"></span>
              <span class="dnode-text">Runtime A</span>
              <span class="dnode-meta">dedicated</span>
            </div>
            <div class="dnode dnode-db dnode-db--A" style="left:25%; top:83.88%;" data-db>
              <span class="dnode-icon dnode-icon--db"><svg viewBox="0 0 24 24" width="14" height="14"><ellipse cx="12" cy="6" rx="7" ry="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 6v12c0 1.5 3.1 2.5 7 2.5s7-1 7-2.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
              DB A · pg
            </div>

