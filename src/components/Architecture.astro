</style>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>('.arch-deploy');
    if (!root) return;

    const tabs = root.querySelectorAll<HTMLButtonElement>('.arch-deploy-tab');
    const stats = {
      compute: { shared: 'shared · 4×8GB', dedicated: 'dedicated · per-tenant' },
      network: { shared: 'shared egress',  dedicated: 'isolated VNet' },
    };
    const computeEl = root.querySelector<HTMLElement>('[data-deploy-stat="compute"]');
    const networkEl = root.querySelector<HTMLElement>('[data-deploy-stat="network"]');

    const setMode = (mode: 'shared' | 'dedicated') => {
      root.setAttribute('data-deploy-mode', mode);
      tabs.forEach((t) => {
        const active = t.dataset.mode === mode;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (computeEl) computeEl.textContent = stats.compute[mode];
      if (networkEl) networkEl.textContent = stats.network[mode];
    };

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const m = btn.dataset.mode as 'shared' | 'dedicated';
        if (m) {
          setMode(m);
          stopAuto();
        }
      });
    });

    /* Auto-cycle between modes every 8s — pauses if user clicks a tab,
       and pauses when the section is offscreen so it's not racing while
       hidden. */
    let timer: number | null = null;
    let stopped = false;
    const startAuto = () => {
      if (stopped || timer) return;
      timer = window.setInterval(() => {
        const next = root.dataset.deployMode === 'shared' ? 'dedicated' : 'shared';
        setMode(next as 'shared' | 'dedicated');
      }, 8000);
    };
    const stopAuto = () => {
      stopped = true;
      if (timer) { window.clearInterval(timer); timer = null; }
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !stopped) startAuto();
          else if (timer) { window.clearInterval(timer); timer = null; }
        }
      }, { threshold: 0.4 });
      io.observe(root);
    } else {
      startAuto();
    }
  })();
</script>
