---
import { moduleGroups, allModuleCount } from '../data/modules';

const specialized: { codes: string; key: string; label: string }[] = [
  { codes: 'HM/HE', key: 'modules.spec.HM_HE', label: 'hub & endpoint adapters' },
  { codes: 'DC/DL', key: 'modules.spec.DC_DL', label: 'data catalog · data lake' },
  { codes: 'OM/OS', key: 'modules.spec.OM_OS', label: 'object model · object service' },
  { codes: 'PD/PM', key: 'modules.spec.PD_PM', label: 'person master data' },
  { codes: 'YE',    key: 'modules.spec.YE',    label: 'year-end accounting' },
];

const seed = moduleGroups[0];
const seedModule = seed.modules[0];
---

<section id="modules" class="section">
  <div class="absolute inset-0 -z-10 bg-grid opacity-30 mask-fade-bottom"></div>
  <div class="blob blob-violet w-[480px] h-[480px] -top-20 right-[-160px] opacity-50" data-parallax="0.15"></div>

  <div class="container-wide">
    <div class="max-w-3xl reveal">
      <p class="section-eyebrow" data-i18n="modules.eyebrow">Architecture · 64+ purpose-built modules</p>
      <h2 class="section-heading mt-3">
        <span data-i18n="modules.heading.a">A periodic table for</span>
        <span class="gradient-text" data-i18n="modules.heading.b">insurance distribution.</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed" data-i18n="modules.body">
        Alpha is a modular monolith. Each business module owns a single domain — customers, contracts, billing.
        Each framework module provides reusable infrastructure — workflow, notifications, documents, integration.
        New partners and products are onboarded through configuration of these modules, not new code.
      </p>
    </div>

    <div class="cap-stats reveal mt-8" data-reveal="scale">
      <span class="cap-stat">
        <span class="cap-stat-num" data-count data-count-duration="1100">{allModuleCount}</span>
        <span class="cap-stat-label" data-i18n="modules.stat.modules">modules</span>
      </span>
      <span class="cap-stat-sep" aria-hidden="true">·</span>
      <span class="cap-stat">
        <span class="cap-stat-num" data-count data-count-duration="900">{moduleGroups.length}</span>
        <span class="cap-stat-label" data-i18n="modules.stat.domains">domains</span>
      </span>
      <span class="cap-stat-sep" aria-hidden="true">·</span>
      <span class="cap-stat">
        <span class="cap-stat-num" data-count data-count-duration="900">1</span>
        <span class="cap-stat-label" data-i18n="modules.stat.codebase">codebase</span>
      </span>
    </div>

    <div class="cap-filters reveal mt-7" data-reveal="scale" role="tablist" data-mod-filters>
      <button type="button" class="cap-filter is-active" data-mod-filter="all" role="tab" aria-selected="true">
        <span data-i18n="modules.filters.all">All</span>
        <span class="cap-filter-count">{allModuleCount}</span>
      </button>
      {moduleGroups.map((g) => (
        <button type="button" class="cap-filter" data-mod-filter={g.id} role="tab" aria-selected="false">
          <span data-i18n={`modules.group.${g.id}.title`}>{g.title}</span>
          <span class="cap-filter-count">{g.modules.length}</span>
        </button>
      ))}
    </div>

    <div class="mod-board mt-10" data-mod-board>
      <aside class="mod-spotlight reveal" data-reveal="blur">
        <span class="mod-spot-grid" aria-hidden="true"></span>
        <span class="mod-spot-glow" aria-hidden="true"></span>

        <div class="mod-spot-meta">
          <span class="mod-spot-live">
            <span class="mod-spot-dot"></span>
            <span data-i18n="modules.spotlight.live">Live module</span>
          </span>
          <span class="mod-spot-domain" data-mod-spot-domain data-i18n={`modules.group.${seed.id}.title`}>{seed.title}</span>
        </div>

        <div class="mod-spot-code-wrap">
          <span class="mod-spot-code" data-mod-spot-code>{seedModule.code}</span>
        </div>

        <div class="mod-spot-name" data-mod-spot-name data-i18n={`modules.m.${seedModule.code}.name`}>{seedModule.name}</div>
        <p class="mod-spot-desc" data-mod-spot-desc>{seedModule.desc}</p>

        <div class="mod-spot-progress">
          <span class="mod-spot-bar"><span class="mod-spot-bar-fill" data-mod-spot-fill></span></span>
          <span class="mod-spot-counter">
            <span data-mod-spot-i>1</span>
            <span class="mod-spot-counter-sep">/</span>
            <span data-mod-spot-n>{seed.modules.length}</span>
          </span>
        </div>

        <div class="mod-spot-hint" data-i18n="modules.spotlight.hint">Hover any tile · auto-cycles</div>
      </aside>

      <div class="mod-grid">
        {moduleGroups.map((g, gi) => (
          <article class="mod-group reveal" data-reveal="left" data-mod-group={g.id} style={`--gi:${gi};--rd:${gi * 0.6}s`}>
            <header class="mod-group-head">
              <h3 class="mod-group-title" data-i18n={`modules.group.${g.id}.title`}>{g.title}</h3>
              <span class="mod-group-count">{g.modules.length}</span>
              <p class="mod-group-tagline" data-i18n={`modules.group.${g.id}.tagline`}>{g.tagline}</p>
            </header>
            <div class="mod-group-rail" aria-hidden="true">
              <span class="mod-group-rail-pulse"></span>
            </div>
            <div class="mod-tiles">
              {g.modules.map((m, mi) => (
                <button
                  type="button"
                  class="mod-tile"
                  data-mod-tile
                  data-code={m.code}
                  data-desc={m.desc}
                  data-domain-key={`modules.group.${g.id}.title`}
                  data-name-key={`modules.m.${m.code}.name`}
                  data-i={mi}
                  data-n={g.modules.length}
                  style={`--mi:${mi}`}
                  aria-label={`${m.code} · ${m.name}`}
                >
                  <span class="mod-tile-code">{m.code}</span>
                  <span class="mod-tile-name" data-i18n={`modules.m.${m.code}.name`}>{m.name}</span>
                  <span class="mod-tile-shine" aria-hidden="true"></span>
                  <span class="mod-tile-corner" aria-hidden="true">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none">
                      <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </span>
                </button>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-10 reveal flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-white/55">
      <span class="font-mono uppercase text-xs tracking-[0.18em] text-white/40" data-i18n="modules.specialized">+ specialized modules</span>
      {specialized.map((s) => (
        <span class="inline-flex items-center gap-2">
          <span class="font-mono text-xs gradient-text-strong">{s.codes}</span>
          <span class="text-white/55 text-xs" data-i18n={s.key}>{s.label}</span>
        </span>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const board = document.querySelector('[data-mod-board]');
      if (!board) return;
      const tiles = Array.from(board.querySelectorAll('[data-mod-tile]'));
      if (!tiles.length) return;

      const spotCode   = board.querySelector('[data-mod-spot-code]');
      const spotName   = board.querySelector('[data-mod-spot-name]');
      const spotDesc   = board.querySelector('[data-mod-spot-desc]');
      const spotDomain = board.querySelector('[data-mod-spot-domain]');
      const spotFill   = board.querySelector('[data-mod-spot-fill]');
      const spotI      = board.querySelector('[data-mod-spot-i]');
      const spotN      = board.querySelector('[data-mod-spot-n]');
      const filters    = Array.from(document.querySelectorAll('[data-mod-filters] [data-mod-filter]'));

      let activeFilter = 'all';
      let cycleIdx = 0;
      let cycleTimer = 0;
      let isPaused = false;
      let inView = false;

      const getCycleTiles = () =>
        activeFilter === 'all'
          ? tiles
          : tiles.filter((t) => t.closest('[data-mod-group]')?.getAttribute('data-mod-group') === activeFilter);

      const setSpot = (tile, animate = true) => {
        if (!tile) return;
        const swap = 'is-swapping';
        const els = [spotCode, spotName, spotDesc, spotDomain].filter(Boolean);

        const apply = () => {
          const nameEl = tile.querySelector('.mod-tile-name');
          const code = tile.getAttribute('data-code') || '';
          const name = (nameEl && nameEl.textContent) || '';
          const desc = tile.getAttribute('data-desc') || '';
          const domainKey = tile.getAttribute('data-domain-key') || '';
          const nameKey = tile.getAttribute('data-name-key') || '';
          const groupEl = tile.closest('[data-mod-group]');
          const domainTitle = groupEl ? groupEl.querySelector('.mod-group-title') : null;

          if (spotCode) spotCode.textContent = code;
          if (spotName) {
            spotName.textContent = name;
            if (nameKey) spotName.setAttribute('data-i18n', nameKey);
          }
          if (spotDesc) spotDesc.textContent = desc;
          if (spotDomain) {
            spotDomain.textContent = domainTitle ? domainTitle.textContent : '';
            if (domainKey) spotDomain.setAttribute('data-i18n', domainKey);
          }

          const i = Number(tile.getAttribute('data-i') || 0);
          const n = Number(tile.getAttribute('data-n') || 1);
          if (spotFill) spotFill.style.width = (((i + 1) / n) * 100) + '%';
          if (spotI) spotI.textContent = String(i + 1);
          if (spotN) spotN.textContent = String(n);

          tiles.forEach((t) => t.classList.toggle('is-active', t === tile));
          els.forEach((el) => el.classList.remove(swap));
        };

        if (animate) {
          els.forEach((el) => el.classList.add(swap));
          setTimeout(apply, 180);
        } else {
          apply();
        }
      };

      const startCycle = () => {
        stopCycle();
        cycleTimer = window.setInterval(() => {
          if (isPaused || !inView) return;
          const cyc = getCycleTiles();
          if (!cyc.length) return;
          cycleIdx = (cycleIdx + 1) % cyc.length;
          setSpot(cyc[cycleIdx]);
        }, 3200);
      };
      const stopCycle = () => { if (cycleTimer) { clearInterval(cycleTimer); cycleTimer = 0; } };

      tiles.forEach((tile) => {
        tile.addEventListener('mouseenter', () => {
          isPaused = true;
          setSpot(tile);
          const cyc = getCycleTiles();
          const idx = cyc.indexOf(tile);
          if (idx >= 0) cycleIdx = idx;
        });
        tile.addEventListener('mouseleave', () => { isPaused = false; });
        tile.addEventListener('focus', () => {
          isPaused = true;
          setSpot(tile);
        });
        tile.addEventListener('blur', () => { isPaused = false; });
      });

      filters.forEach((f) => {
        f.addEventListener('click', () => {
          const id = f.getAttribute('data-mod-filter') || 'all';
          filters.forEach((x) => {
            const on = x === f;
            x.classList.toggle('is-active', on);
            x.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          activeFilter = id;
          board.querySelectorAll('[data-mod-group]').forEach((g) => {
            const gid = g.getAttribute('data-mod-group');
            const match = id === 'all' || gid === id;
            g.classList.toggle('is-dim', !match);
          });
          cycleIdx = 0;
          const cyc = getCycleTiles();
          if (cyc.length) setSpot(cyc[0]);
        });
      });

      const visObs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { inView = e.isIntersecting; });
      }, { threshold: 0.05 });
      visObs.observe(board);

      startCycle();
    })();
  </script>
</section>
