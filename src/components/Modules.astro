---
import { moduleGroups } from '../data/modules';

const specialized: { codes: string; key: string; label: string }[] = [
  { codes: 'HM/HE', key: 'modules.spec.HM_HE', label: 'hub & endpoint adapters' },
  { codes: 'DC/DL', key: 'modules.spec.DC_DL', label: 'data catalog · data lake' },
  { codes: 'OM/OS', key: 'modules.spec.OM_OS', label: 'object model · object service' },
  { codes: 'PD/PM', key: 'modules.spec.PD_PM', label: 'person master data' },
  { codes: 'YE',    key: 'modules.spec.YE',    label: 'year-end accounting' },
];
---

<section id="modules" class="section">
  <div class="absolute inset-0 -z-10 bg-grid opacity-30 mask-fade-bottom"></div>
  <div class="blob blob-violet w-[480px] h-[480px] -top-20 right-[-160px] opacity-50" data-parallax="0.15"></div>

  <div class="container-wide">
    <div class="max-w-3xl reveal">
      <p class="section-eyebrow" data-i18n="modules.eyebrow">Architecture · 64+ purpose-built modules</p>
      <h2 class="section-heading mt-3">
        <span data-i18n="modules.heading.a">A periodic table for</span>
        <span class="gradient-text" data-i18n="modules.heading.b">insurance distribution.</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed" data-i18n="modules.body">
        Alpha is a modular monolith. Each business module owns a single domain — customers, contracts, billing.
        Each framework module provides reusable infrastructure — workflow, notifications, documents, integration.
        New partners and products are onboarded through configuration of these modules, not new code.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" data-stagger>
      {moduleGroups.map((g) => (
        <article class={`reveal group relative rounded-2xl p-[1px] bg-gradient-to-br ${g.hue} hover:scale-[1.01] transition-transform duration-[var(--t-short)] ease-[var(--ease-soft)]`} data-reveal="scale">
          <div class="spotlight rounded-2xl bg-alpha-deep/80 backdrop-blur p-5 h-full">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-semibold tracking-tight" data-i18n={`modules.group.${g.id}.title`}>{g.title}</h3>
                <p class="text-xs text-white/50 mt-1.5" data-i18n={`modules.group.${g.id}.tagline`}>{g.tagline}</p>
              </div>
              <span class="font-mono text-[10px] px-2 py-1 rounded-md bg-white/[0.04] border border-white/10 text-white/55 tracking-wider whitespace-nowrap">
                {g.modules.length} <span data-i18n="nav.modules">modules</span>
              </span>
            </div>

            {/* `data-modules-grid` opts this 4-col tile grid into the
                proximity-glow runtime at the bottom of this file: hovering
                one tile faintly brightens its row neighbors (3 sibling
                tiles in the same row), reinforcing the "periodic table"
                metaphor where rows have meaning. --tile-i carries the
                per-tile stagger index for the entrance fade — see
                .reveal .module-tile in global.css. */}
            <div class="mt-5 grid grid-cols-4 gap-2" data-modules-grid>
              {g.modules.map((m, i) => (
                <div class="module-tile" data-code={m.code} style={`--tile-i:${i}`}>
                  <span class="font-mono text-base font-semibold tracking-tight gradient-text-strong leading-none">
                    {m.code}
                  </span>
                  <span class="text-[10px] text-white/55 leading-tight" data-i18n={`modules.m.${m.code}.name`}>{m.name}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 reveal flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-white/55">
      <span class="font-mono uppercase text-xs tracking-[0.18em] text-white/55" data-i18n="modules.specialized">+ specialized modules</span>
      {specialized.map((s) => (
        <span class="inline-flex items-center gap-2">
          <span class="font-mono text-xs gradient-text-strong">{s.codes}</span>
          <span class="text-white/55 text-xs" data-i18n={s.key}>{s.label}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  // Row-proximity glow. When the pointer enters a .module-tile, the
  // other tiles in its row get .is-near (faint brighten via global.css).
  // The grid is a fixed 4-column layout, so a row is `floor(i/4)*4` …
  // `+4`. We delegate one pointerover per [data-modules-grid] container
  // and dedupe consecutive events on the same tile so the same brighten
  // doesn't get reapplied on every micro-pixel of pointer movement.
  //
  // Reduced-motion users skip this entirely — the static gradient borders
  // and resting tile state already tell the structural story.
  const wireProximity = () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    document.querySelectorAll<HTMLElement>('[data-modules-grid]').forEach((grid) => {
      if (grid.dataset.proximityWired === '1') return;
      grid.dataset.proximityWired = '1';
      const tiles = Array.from(grid.querySelectorAll<HTMLElement>('.module-tile'));
      const cols = 4;
      let last: HTMLElement | null = null;
      const clear = () => {
        if (last) {
          tiles.forEach((t) => t.classList.remove('is-near'));
          last = null;
        }
      };
      grid.addEventListener('pointerover', (e) => {
        const target = e.target instanceof Element ? e.target.closest<HTMLElement>('.module-tile') : null;
        if (!target || target === last) return;
        last = target;
        const idx = tiles.indexOf(target);
        if (idx < 0) return;
        const rowStart = Math.floor(idx / cols) * cols;
        const rowEnd = rowStart + cols;
        tiles.forEach((t, i) => {
          t.classList.toggle('is-near', i >= rowStart && i < rowEnd && i !== idx);
        });
      });
      grid.addEventListener('pointerleave', clear);
    });
  };
  wireProximity();
  document.addEventListener('astro:page-load', wireProximity);
</script>
