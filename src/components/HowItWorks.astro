---
const steps = [
  {
    n: '01',
    title: 'Capture',
    body: 'Leads, applications and partner data flow in via web forms, agents, REST/SOAP, BiPRO 420/430, GDV files or batch import.',
    modules: ['LM', 'CR', 'HC', 'HB', 'HG', 'IM'],
    meta: [
      ['Channels', '6'],
      ['Latency', '< 200 ms'],
    ],
  },
  {
    n: '02',
    title: 'Advise & Apply',
    body: 'The Case Wizard guides the agent through an IDD-compliant advisory session, captures need analysis, and prepares a signed application.',
    modules: ['CW', 'TE', 'CR', 'AM'],
    meta: [
      ['Compliance', 'IDD'],
      ['Steps', '12'],
    ],
  },
  {
    n: '03',
    title: 'Sign',
    body: 'The customer signs digitally — eIDAS-AES — via email, SMS, phone or in person, through integrated providers like InSign.',
    modules: ['SM', 'NS', 'DM'],
    meta: [
      ['Standard', 'eIDAS-AES'],
      ['Channels', '4'],
    ],
  },
  {
    n: '04',
    title: 'Convert',
    body: 'A validated application is automatically converted into a contract, customer profile and billing account. No manual rekeying.',
    modules: ['CW', 'CM', 'CR', 'BM'],
    meta: [
      ['Rekey', '0%'],
      ['Throughput', 'real-time'],
    ],
  },
  {
    n: '05',
    title: 'Bill & Reconcile',
    body: 'Billing runs collect due payments via SEPA. PAIN.008 files go to the bank, CAMT files come back. Six-stage automatic matching settles balances. Multi-stage dunning if needed.',
    modules: ['BM', 'WF', 'NS', 'JB'],
    meta: [
      ['Format', 'SEPA / PAIN.008'],
      ['Match rate', '99.2%'],
    ],
  },
  {
    n: '06',
    title: 'Engage',
    body: 'Customers self-serve through a separate portal — passwordless OTP login, contracts, documents, claims, appointment booking. Notifications across email, SMS, Push, Teams, WhatsApp.',
    modules: ['EU', 'EX', 'NS', 'TM', 'AS'],
    meta: [
      ['Channels', '5'],
      ['Login', 'OTP'],
    ],
  },
  {
    n: '07',
    title: 'Audit & Comply',
    body: 'Every field change at every step is captured by Hibernate Envers — who, what, before, after, when. 7-year retention, ISO/SOC/GDPR/eIDAS-aligned.',
    modules: ['envers', 'UM', 'RP'],
    meta: [
      ['Retention', '7 years'],
      ['Trail', 'Field-level'],
    ],
  },
  {
    n: '08',
    title: 'Adapt',
    body: 'New products, partners, workflows, calculations and notifications are configured — not coded — through the Logic, Workflow, Notification, Template and Mapping modules.',
    modules: ['LG', 'WF', 'NS', 'TE', 'EM'],
    meta: [
      ['Configured', 'Not coded'],
      ['Modules', '5'],
    ],
  },
];
---

<section id="how-it-works" class="section">
  <div class="container-wide">
    <div class="hiw-head reveal">
      <div class="max-w-2xl">
        <p class="section-eyebrow" data-i18n="how.eyebrow">How it works</p>
        <h2 class="section-heading mt-3">
          <span data-i18n="how.heading.a">From first lead to</span>
          <span class="gradient-text" data-i18n="how.heading.b">audited contract.</span>
        </h2>
        <p class="mt-5 text-lg text-white/65 leading-relaxed" data-i18n="how.body">
          One lifecycle. Eight orchestrated stages. Every transition driven by configurable workflows, every change recorded.
        </p>
      </div>
    </div>

    <div class="hiw-variant reveal" data-reveal="scale">
      <div class="const-wrap" data-const-wrap>
        <svg class="const-svg" data-const-svg preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="hiwConstGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#c4b5fd" />
              <stop offset="50%" stop-color="#9d7bff" />
              <stop offset="100%" stop-color="#f093fb" />
            </linearGradient>
          </defs>
          <path class="const-path-bg" data-const-bg></path>
          <path class="const-path-fg" data-const-fg></path>
        </svg>

        <div class="const-stages" data-const-stages>
          {steps.map((s, i) => {
            const parts = s.title.split(' & ');
            const head = parts[0];
            const accent = parts[1] ? `& ${parts[1]}` : null;
            return (
              <div class="const-stage" data-i={i}>
                <div class="const-marker" aria-hidden="true">{s.n}</div>
                <div class="const-card">
                  <span class="const-eyebrow">Stage {s.n}</span>
                  <h3 class="const-title" data-i18n={`how.s.${i + 1}.title`}>
                    {accent ? (
                      <>
                        {head} <span class="const-accent">{accent}</span>
                      </>
                    ) : (
                      head
                    )}
                  </h3>
                  <p class="const-desc" data-i18n={`how.s.${i + 1}.body`}>{s.body}</p>
                  <div class="const-chips">
                    {s.modules.map((m) => <span>{m}</span>)}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hiw-head {
    max-width: 48rem;
  }

  .hiw-variant {
    margin-top: 3.5rem;
  }

  /* ============================================================== */
  /* CONSTELLATION                                                  */
  /* ============================================================== */
  .const-wrap {
    position: relative;
    padding: 40px 0;
  }
  .const-svg {
    position: absolute;
    left: 0; top: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .const-path-bg {
    fill: none;
    stroke: var(--border-3);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
    opacity: 0.7;
  }
  .const-path-fg {
    fill: none;
    stroke: url(#hiwConstGrad);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.08s linear;
    filter: drop-shadow(0 0 8px rgba(157, 123, 255, 0.45));
  }

  .const-stages {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 140px;
  }
  .const-stage {
    position: relative;
    width: 46%;
    opacity: 0.35;
    transform: translateY(20px) scale(0.97);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .const-stage.is-in { opacity: 1; transform: none; }
  .const-stage:nth-child(odd)  { margin-left: 0; }
  .const-stage:nth-child(even) { margin-left: 54%; }

  .const-card {
    border: 1px solid var(--border-2);
    border-radius: 18px;
    padding: 28px;
    /* Opaque base (page bg) under the tinted gradient so the gradient
       connector line never bleeds through the card. */
    background:
      linear-gradient(180deg, var(--surface-strong), var(--surface)),
      var(--bg);
    backdrop-filter: blur(8px);
    position: relative;
    z-index: 1;
  }
  .const-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 18px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(196, 181, 253, 0.55), transparent 40%, transparent 60%, rgba(240, 147, 251, 0.40));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .const-stage.is-in .const-card::before { opacity: 1; }

  .const-marker {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid #c9b6ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: #c9b6ff;
    letter-spacing: 0.05em;
    top: -24px;
    z-index: 2;
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 28px rgba(201, 182, 255, 0.45);
  }
  :root[data-theme='light'] .const-marker { color: #6d28d9; border-color: #6d28d9; }

  .const-stage:nth-child(odd)  .const-marker { right: -24px; }
  .const-stage:nth-child(even) .const-marker { left: -24px; }

  .const-eyebrow {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: #c9b6ff;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: block;
  }
  :root[data-theme='light'] .const-eyebrow { color: #6d28d9; }

  .const-title {
    font-family: 'Inter Variable', Inter, sans-serif;
    font-weight: 600;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--fg-strong);
  }
  .const-accent {
    background: linear-gradient(135deg, #667eea, #f093fb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
    font-weight: 500;
  }
  .const-desc {
    color: color-mix(in srgb, var(--fg) 70%, transparent);
    line-height: 1.6;
    margin: 0 0 18px;
    font-size: 15px;
  }
  .const-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .const-chips span {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 9px;
    border: 1px solid var(--border-2);
    border-radius: 5px;
    color: color-mix(in srgb, var(--fg) 65%, transparent);
  }

  /* ── Responsive ────────────────────────────────────────────────── */
  @media (max-width: 920px) {
    /* Horizontal padding on the wrap gives the side-mounted markers
       (and their glow) room so they never clip at the viewport edges. */
    .const-wrap { padding: 40px 32px; }

    /* Keep the alternating zigzag on mobile — narrower cards, smaller
       offset, but still left/right alternation so the connector curves
       just like desktop. */
    .const-stage { width: 80% !important; }
    .const-stage:nth-child(odd)  { margin-left: 0 !important; }
    .const-stage:nth-child(even) { margin-left: 20% !important; }

    .const-stage:nth-child(odd)  .const-marker {
      right: -24px; left: auto; top: -24px;
    }
    .const-stage:nth-child(even) .const-marker {
      left: -24px; right: auto; top: -24px;
    }

    .const-stages { gap: 140px; }
    .const-path-fg { stroke-width: 3; }
    .const-path-bg { stroke-width: 1.5; opacity: 0.5; }
  }

  @media (max-width: 480px) {
    .const-wrap { padding: 40px 24px; }
    .const-marker { width: 40px; height: 40px; font-size: 10px; top: -20px; }
    .const-stage:nth-child(odd)  .const-marker { right: -20px; top: -20px; }
    .const-stage:nth-child(even) .const-marker { left: -20px; top: -20px; }
    .const-card { padding: 20px; }
    .const-stage { width: 82% !important; }
    .const-stage:nth-child(even) { margin-left: 18% !important; }
    .const-stages { gap: 120px; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .const-path-fg { transition: none; }
    .const-stage { transition-duration: 0ms; }
  }
</style>

<script>
  {
    const constWrap = document.querySelector<HTMLElement>('[data-const-wrap]');
    const constSvg = document.querySelector<SVGSVGElement>('[data-const-svg]');
    const constBg = document.querySelector<SVGPathElement>('[data-const-bg]');
    const constFg = document.querySelector<SVGPathElement>('[data-const-fg]');
    let constLen = 0;
    let constSegLens: number[] = [];
    let constRafId = 0;

    function buildConstPath() {
      if (!constWrap || !constSvg || !constBg || !constFg) return;
      // Only meaningful when this variant is laid out
      if (!constWrap.offsetParent && constWrap.offsetWidth === 0) return;
      const w = constWrap.clientWidth;
      const h = constWrap.clientHeight;
      if (w === 0 || h === 0) return;
      constSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      constSvg.setAttribute('width', String(w));
      constSvg.setAttribute('height', String(h));

      const markers = constWrap.querySelectorAll<HTMLElement>('.const-marker');
      const wrapRect = constWrap.getBoundingClientRect();
      const pts = [...markers].map((m) => {
        const r = m.getBoundingClientRect();
        return {
          x: r.left - wrapRect.left + r.width / 2,
          y: r.top - wrapRect.top + r.height / 2,
        };
      });
      if (pts.length < 2) return;

      // Build path one segment at a time and read getTotalLength() after each,
      // so we know the precise path length at every marker.
      let d = `M ${pts[0].x} ${pts[0].y}`;
      constFg.setAttribute('d', d);
      constSegLens = [0];
      for (let i = 1; i < pts.length; i++) {
        const p0 = pts[i - 1];
        const p1 = pts[i];
        const cy = (p0.y + p1.y) / 2;
        d += ` C ${p0.x} ${cy}, ${p1.x} ${cy}, ${p1.x} ${p1.y}`;
        constFg.setAttribute('d', d);
        constSegLens.push(constFg.getTotalLength());
      }
      constBg.setAttribute('d', d);
      constLen = constSegLens[constSegLens.length - 1] || 0;
      constFg.style.strokeDasharray = String(constLen);
      updateConstProgress();
    }

    function updateConstProgress() {
      if (!constWrap || !constFg) return;
      if (constLen === 0 || constSegLens.length < 2) return;

      const vh = window.innerHeight;
      const triggerY = vh * 0.55;

      const markers = constWrap.querySelectorAll<HTMLElement>('.const-marker');
      const stages = constWrap.querySelectorAll<HTMLElement>('.const-stage');
      if (markers.length < 2 || markers.length !== constSegLens.length) return;

      const ys: number[] = [];
      for (let i = 0; i < markers.length; i++) {
        const r = markers[i].getBoundingClientRect();
        ys.push(r.top + r.height / 2);
      }

      // Map the trigger line to a path length by interpolating between the
      // path lengths at consecutive markers.
      let lengthAtTrigger = 0;
      if (triggerY >= ys[ys.length - 1]) {
        lengthAtTrigger = constLen;
      } else if (triggerY > ys[0]) {
        for (let i = 0; i < ys.length - 1; i++) {
          if (triggerY >= ys[i] && triggerY <= ys[i + 1]) {
            const span = ys[i + 1] - ys[i] || 1;
            const localT = (triggerY - ys[i]) / span;
            lengthAtTrigger =
              constSegLens[i] + (constSegLens[i + 1] - constSegLens[i]) * localT;
            break;
          }
        }
      }

      constFg.style.strokeDashoffset = String(Math.max(0, constLen - lengthAtTrigger));

      // Toggle is-in symmetrically so reverse-scrolling unhighlights cards.
      stages.forEach((s, i) => {
        s.classList.toggle('is-in', triggerY >= ys[i] - 40);
      });
    }

    function onConstScroll() {
      if (constRafId) return;
      constRafId = requestAnimationFrame(() => {
        constRafId = 0;
        updateConstProgress();
      });
    }

    window.addEventListener('scroll', onConstScroll, { passive: true });
    window.addEventListener('resize', buildConstPath);
    requestAnimationFrame(buildConstPath);
  }
</script>
