---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Modules from '../components/Modules.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Capabilities from '../components/Capabilities.astro';
import AISection from '../components/AISection.astro';
import UseCases from '../components/UseCases.astro';
import Architecture from '../components/Architecture.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    {/* Section seams: a barely-there gradient hairline that suggests the
        page is one continuous canvas instead of stacked boxes. Functional —
        cues spatial continuity to the eye between sections. */}
    <div class="container-wide"><div class="section-seam"></div></div>
    <ProblemSolution />
    <div class="container-wide"><div class="section-seam"></div></div>
    <Modules />
    <div class="container-wide"><div class="section-seam"></div></div>
    <HowItWorks />
    <div class="container-wide"><div class="section-seam"></div></div>
    <Capabilities />
    <div class="container-wide"><div class="section-seam"></div></div>
    <AISection />
    <div class="container-wide"><div class="section-seam"></div></div>
    <UseCases />
    <div class="container-wide"><div class="section-seam"></div></div>
    <Architecture />
    <CTA />
  </main>
  <Footer />
</Layout>
