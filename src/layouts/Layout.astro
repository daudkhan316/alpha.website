---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alpha Platform — Insurance distribution, end to end.',
  description = 'Alpha is the modular insurance management platform for brokers, agencies, and distributors — customers, contracts, billing, signatures, documents, commissions and the customer portal in one audit-grade, multi-tenant system. Hosted in Microsoft Azure Germany.',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#08061a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5ff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    {/* No-flash theme + locale init: read saved choice or system preference, before paint.
        Locale defaults to English; the German option is a stub (a partial dictionary
        + runtime swap) intended for translator review, not production. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('alpha-theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = saved || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        try {
          var savedLocale = localStorage.getItem('alpha-locale');
          var locale = (savedLocale === 'de' || savedLocale === 'en') ? savedLocale : 'en';
          document.documentElement.setAttribute('data-locale', locale);
          document.documentElement.lang = locale;
        } catch (e) {
          document.documentElement.setAttribute('data-locale', 'en');
          document.documentElement.lang = 'en';
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Fonts are self-hosted via @fontsource-variable in src/styles/global.css.
        No third-party requests to fonts.googleapis.com — required for DSGVO. */}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Alpha Platform",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    })} />
  </head>
  <body class="relative min-h-screen overflow-x-hidden">
    {/* DE stub banner — visible only when the user has switched to German.
        A blunt heads-up that copy is partially translated. */}
    <div
      data-locale-banner
      role="status"
      class="hidden fixed top-2 left-1/2 -translate-x-1/2 z-[70] px-4 py-1.5 rounded-full text-[11px] font-medium"
      style="background: var(--surface-strong); border: 1px solid var(--border-3); color: var(--fg); backdrop-filter: blur(20px);"
    >
      <span data-i18n="locale.deBeta">Deutsche Übersetzung ist ein Maschinenentwurf — Prüfung ausstehend</span>
    </div>

    <slot />

    <script>
      // Apply persisted locale on first load (after the DOM is fully ready)
      // and keep the DE-stub banner in sync with the active locale.
      import { applyLocale, readSavedLocale } from '../i18n/runtime';

      const initialLocale = readSavedLocale();
      applyLocale(initialLocale);

      const banner = document.querySelector<HTMLElement>('[data-locale-banner]');
      const syncBanner = (locale: string) => {
        if (banner) banner.classList.toggle('hidden', locale !== 'de');
      };
      syncBanner(initialLocale);
      window.addEventListener('alpha:locale-changed', (e: Event) => {
        const ev = e as CustomEvent<{ locale: string }>;
        syncBanner(ev.detail.locale);
      });
    </script>

    <script>
      // Lightweight scroll-reveal — no library, no jank.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      const scan = () => {
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => observer.observe(el));
      };
      scan();
      document.addEventListener('astro:page-load', scan);
    </script>
  </body>
</html>
