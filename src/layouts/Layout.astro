---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alpha Platform — Versicherungsverteilung, durchgängig.',
  description = 'Alpha ist die modulare Plattform für Versicherungsverwaltung für Makler, Agenturen und Vertriebe — Kunden, Verträge, Inkasso, Signaturen, Dokumente, Provisionen und Kundenportal in einem revisionssicheren, mandantenfähigen System. Gehostet bei Microsoft Azure Deutschland.',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#08061a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5ff" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    {/* No-flash theme + locale init: read saved choice or system preference, before paint.
        Locale default is German (Klaus is a German-market product). EN is
        available via the EN/DE toggle in the nav. The DE dictionary is a
        machine draft — needs native review before launch. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('alpha-theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = saved || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        try {
          var savedLocale = localStorage.getItem('alpha-locale');
          var locale = (savedLocale === 'de' || savedLocale === 'en') ? savedLocale : 'de';
          document.documentElement.setAttribute('data-locale', locale);
          document.documentElement.lang = locale;
        } catch (e) {
          document.documentElement.setAttribute('data-locale', 'de');
          document.documentElement.lang = 'de';
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Fonts are self-hosted via @fontsource-variable in src/styles/global.css.
        No third-party requests to fonts.googleapis.com — required for DSGVO. */}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Alpha Platform",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    })} />
  </head>
  <body class="relative min-h-screen overflow-x-clip">
    {/* DE stub banner — visible only when the user has switched to German.
        A blunt heads-up that copy is partially translated. */}
    <div
      data-locale-banner
      role="status"
      class="hidden fixed top-2 left-1/2 -translate-x-1/2 z-[70] px-4 py-1.5 rounded-full text-[11px] font-medium"
      style="background: var(--surface-strong); border: 1px solid var(--border-3); color: var(--fg); backdrop-filter: blur(20px);"
    >
      <span data-i18n="locale.deBeta">Deutsche Übersetzung ist ein Maschinenentwurf — Prüfung ausstehend</span>
    </div>

    <slot />

    <script>
      // Apply persisted locale on first load (after the DOM is fully ready)
      // and keep the DE-stub banner in sync with the active locale.
      import { applyLocale, readSavedLocale } from '../i18n/runtime';

      const initialLocale = readSavedLocale();
      applyLocale(initialLocale);
      // Notify other modules that the locale has been applied. Module-script
      // execution order vs the reveals module is not deterministic in dev, so
      // the reveals module listens for this event and (re)splits its
      // .reveal-line headlines into per-word spans against the active text.
      window.dispatchEvent(new CustomEvent('alpha:locale-changed', { detail: { locale: initialLocale } }));

      const banner = document.querySelector<HTMLElement>('[data-locale-banner]');
      const syncBanner = (locale: string) => {
        if (banner) banner.classList.toggle('hidden', locale !== 'de');
      };
      syncBanner(initialLocale);
      window.addEventListener('alpha:locale-changed', (e: Event) => {
        const ev = e as CustomEvent<{ locale: string }>;
        syncBanner(ev.detail.locale);
      });
    </script>

    <script>
      // Lightweight scroll-reveal — no library, no jank.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      const scan = () => {
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => observer.observe(el));
      };
      scan();
      document.addEventListener('astro:page-load', scan);

      // Pointer-aware spotlight: write --mx / --my as percentages on the
      // hovered .spotlight container so its ::before radial-gradient tracks.
      // One global rAF-throttled listener per move; no per-card handlers.
      let spotlightFrame = 0;
      let pendingTarget: Element | null = null;
      let pendingX = 0;
      let pendingY = 0;
      const flushSpotlight = () => {
        spotlightFrame = 0;
        if (pendingTarget instanceof HTMLElement) {
          pendingTarget.style.setProperty('--mx', pendingX + '%');
          pendingTarget.style.setProperty('--my', pendingY + '%');
        }
      };
      document.addEventListener('pointermove', (e) => {
        // `e.target` on document-level pointer events isn't always an
        // Element — pointer events fired against the Document or Window
        // (rare but real, e.g. via dispatchEvent or some extensions)
        // give a target that has no `.closest()`. The optional chain
        // here would only short-circuit on null/undefined, not on
        // existing-but-non-Element targets, so check the type explicitly.
        const target = e.target instanceof Element ? e.target.closest('.spotlight') : null;
        if (!target) return;
        const rect = target.getBoundingClientRect();
        pendingTarget = target;
        pendingX = ((e.clientX - rect.left) / rect.width) * 100;
        pendingY = ((e.clientY - rect.top) / rect.height) * 100;
        if (!spotlightFrame) spotlightFrame = requestAnimationFrame(flushSpotlight);
      }, { passive: true });

      // Stagger: any [data-stagger] container gives its .reveal children
      // an incremental --reveal-delay so they animate in sequence rather
      // than all together when scrolled into view at once.
      const applyStagger = () => {
        document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((root) => {
          // Default 50ms (was 60). With reveal duration at 600ms, a 50ms
          // step gives an 8-item grid a 400ms cascade tail — fits cleanly
          // inside one reveal window so the last item lands while the
          // first is still settling. 60ms made the cascade run past the
          // first item's settle, breaking the "one wave" feel.
          const step = Number(root.dataset.staggerStep || 50);
          const max = Number(root.dataset.staggerMax || 9);
          const items = root.querySelectorAll<HTMLElement>(':scope > .reveal, :scope > * > .reveal');
          items.forEach((el, i) => {
            if (!el.style.getPropertyValue('--reveal-delay')) {
              el.style.setProperty('--reveal-delay', Math.min(i, max) * step + 'ms');
            }
          });
        });
      };
      applyStagger();
      document.addEventListener('astro:page-load', applyStagger);

      // Word-by-word headline reveal. Any .reveal-line wraps each whitespace-
      // separated chunk in <span class="reveal-word"><span>word</span></span>
      // and computes incremental --word-delay so the line writes itself in.
      // We share the parent .reveal's IntersectionObserver — the .reveal-line
      // adds .is-visible to its words when its own .reveal ancestor does.
      // Split a string into .reveal-word spans appended to `host`, with each
      // word's --word-delay incrementing from a shared counter.
      const splitTextInto = (host: HTMLElement, text: string, counter: { i: number }, step: number) => {
        const parts = text.split(/(\s+)/);
        for (const p of parts) {
          if (/^\s+$/.test(p)) {
            host.appendChild(document.createTextNode(p));
          } else if (p.length) {
            const wrap = document.createElement('span');
            wrap.className = 'reveal-word';
            const inner = document.createElement('span');
            inner.style.setProperty('--word-delay', (counter.i * step) + 'ms');
            inner.appendChild(document.createTextNode(p));
            wrap.appendChild(inner);
            host.appendChild(wrap);
            counter.i++;
          }
        }
      };

      // Split each child of .reveal-line into reveal-words. For element
      // children (typically <span data-i18n=...>) we split *inside* the
      // element so it remains in the tree — that way the i18n runtime can
      // still find it on locale change and we re-split via the event.
      const splitWords = (root: HTMLElement) => {
        if (root.dataset.split === '1') return;
        // Default 50ms (was 70). Matches the [data-stagger] step and
        // pulls the per-word cascade tighter — a 5-word headline now
        // cascades over 250ms instead of 350ms, so the line writes
        // itself in just inside one reveal window. Hero overrides this
        // to 45 explicitly; everywhere else inherits this default.
        const step = Number(root.dataset.wordStep || 50);
        const counter = { i: 0 };
        const childNodes = Array.from(root.childNodes);
        // Build a parallel list of replacement nodes / mutated nodes.
        const replacements: Node[] = [];
        for (const n of childNodes) {
          if (n.nodeType === Node.TEXT_NODE) {
            const frag = document.createDocumentFragment();
            const tmp = document.createElement('span');
            splitTextInto(tmp, n.textContent || '', counter, step);
            // Hoist tmp's children into the fragment (we don't want the wrapper).
            while (tmp.firstChild) frag.appendChild(tmp.firstChild);
            replacements.push(frag);
          } else if (n instanceof HTMLElement) {
            const text = n.textContent || '';
            n.textContent = '';
            splitTextInto(n, text, counter, step);
            replacements.push(n);
          }
        }
        root.textContent = '';
        replacements.forEach((r) => root.appendChild(r));
        root.dataset.split = '1';
      };

      const wireWords = (forceResplit = false) => {
        const lines = document.querySelectorAll<HTMLElement>('.reveal-line');
        lines.forEach((line) => {
          if (forceResplit) line.dataset.split = '';
          splitWords(line);
          // Find the nearest .reveal ancestor (or the line itself if it is one)
          // and mirror its is-visible state to the .reveal-word children so
          // they trigger when the headline enters view.
          const host = line.closest('.reveal') as HTMLElement | null;
          if (!host) return;
          const apply = () => {
            const visible = host.classList.contains('is-visible');
            line.querySelectorAll('.reveal-word').forEach((w) => {
              w.classList.toggle('is-visible', visible);
            });
          };
          apply();
          if (line.dataset.wordsObserved !== '1') {
            const mo = new MutationObserver(apply);
            mo.observe(host, { attributes: true, attributeFilter: ['class'] });
            line.dataset.wordsObserved = '1';
          }
        });
      };
      // Initial split. The i18n module may run after this on first paint —
      // we re-split after a microtask AND on locale change to make sure the
      // active-locale text is what gets split into words.
      wireWords();
      Promise.resolve().then(() => wireWords(true));
      document.addEventListener('astro:page-load', () => wireWords(true));
      window.addEventListener('alpha:locale-changed', () => wireWords(true));

      // Pointer-tilt for any .tilt container. One global rAF-throttled
      // listener — no per-element handler. Writes --tx / --ty in [-1, 1].
      let tiltFrame = 0;
      let pendingTilt: HTMLElement | null = null;
      let pendingTx = 0, pendingTy = 0;
      const flushTilt = () => {
        tiltFrame = 0;
        if (pendingTilt) {
          pendingTilt.style.setProperty('--tx', String(pendingTx));
          pendingTilt.style.setProperty('--ty', String(pendingTy));
        }
      };
      document.addEventListener('pointermove', (e) => {
        // Same Element-vs-Document gotcha as the spotlight handler above.
        const target = e.target instanceof Element
          ? (e.target.closest('.tilt, .tilt-strong') as HTMLElement | null)
          : null;
        if (!target) return;
        const r = target.getBoundingClientRect();
        pendingTilt = target;
        pendingTx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        pendingTy = ((e.clientY - r.top) / r.height - 0.5) * 2;
        if (!tiltFrame) tiltFrame = requestAnimationFrame(flushTilt);
      }, { passive: true });
      document.addEventListener('pointerleave', (e) => {
        // pointerleave fired in the capture phase against the document
        // does have e.target === document — exactly the case that throws
        // on the optional chain pattern. Element check guards both.
        const target = e.target instanceof Element
          ? (e.target.closest('.tilt, .tilt-strong') as HTMLElement | null)
          : null;
        if (target) {
          target.style.setProperty('--tx', '0');
          target.style.setProperty('--ty', '0');
        }
      }, true);

      // Scroll-driven parallax. Any [data-parallax] writes --pY in pixels
      // proportional to its distance past the viewport top, scaled by speed.
      // Cheap: one rAF coalesced scroll/resize handler for all elements.
      const parallaxEls = () =>
        Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      let parallaxItems = parallaxEls();
      let parallaxFrame = 0;
      const updateParallax = () => {
        parallaxFrame = 0;
        const vh = window.innerHeight;
        for (const el of parallaxItems) {
          const speed = Number(el.dataset.parallax || '0.15');
          const r = el.getBoundingClientRect();
          // Center of the element relative to viewport center, in viewport units.
          const center = r.top + r.height / 2 - vh / 2;
          el.style.setProperty('--pY', `${(center * -speed).toFixed(1)}px`);
        }
      };
      const requestParallax = () => {
        if (!parallaxFrame) parallaxFrame = requestAnimationFrame(updateParallax);
      };
      updateParallax();
      window.addEventListener('scroll', requestParallax, { passive: true });
      window.addEventListener('resize', () => {
        parallaxItems = parallaxEls();
        requestParallax();
      });
      document.addEventListener('astro:page-load', () => {
        parallaxItems = parallaxEls();
        requestParallax();
      });

      // Numeric count-up. Any [data-count] element gets its leading integer
      // animated from 0 → original on first reveal. The integer + suffix are
      // parsed from the live textContent (after i18n has applied), so the
      // animated suffix matches the active locale (e.g. "-year" / "Jahre").
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const animateCount = (el: HTMLElement) => {
        const original = el.textContent || '';
        const m = original.match(/^(\d+)(.*)$/s);
        if (!m) return;
        const to = Number(m[1]);
        const suffix = m[2];
        const dur = Number(el.dataset.countDuration || '1400');
        if (reduceMotion) { el.textContent = to + suffix; return; }
        el.textContent = '0' + suffix;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const v = Math.round(to * easeOut(t));
          el.textContent = v + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const countObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            countObserver.unobserve(entry.target);
          }
        }
      }, { threshold: 0.4 });
      const wireCounts = () => {
        document.querySelectorAll<HTMLElement>('[data-count]:not([data-counted])').forEach((el) => {
          el.dataset.counted = '1';
          countObserver.observe(el);
        });
      };
      wireCounts();
      document.addEventListener('astro:page-load', wireCounts);

      // AI capability focus stepper. The AI section's left column lays
      // out four capabilities ~28vh apart on lg+, while the right-side
      // terminal panel stays sticky. As the user scrolls, whichever
      // capability is currently in the central viewport band gets
      // .is-focused — that one brightens, the others dim. Apple's
      // product pages do this exact pattern: scroll = navigate
      // features, visual stays anchored.
      //
      // rootMargin shrinks the observation root to a 30%-tall band in
      // the vertical middle of the viewport. With 28vh between steps,
      // exactly one capability sits in that band at a time, so the
      // observer cleanly hands focus from one to the next as the user
      // scrolls. We don't unobserve — the observer keeps running so
      // focus tracks scroll position both forward and backward.
      const focusObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const list = entry.target.closest('[data-cap-list]');
            if (!list) continue;
            list.querySelectorAll('[data-cap-step]').forEach((el) => el.classList.remove('is-focused'));
            entry.target.classList.add('is-focused');
          }
        }
      }, { threshold: 0, rootMargin: '-35% 0px -35% 0px' });
      const wireCapSteps = () => {
        document.querySelectorAll('[data-cap-step]').forEach((el) => focusObserver.observe(el));
      };
      wireCapSteps();
      document.addEventListener('astro:page-load', wireCapSteps);

      // Section-seam activation. The .section-seam hairlines between page
      // sections (in index.astro) get marked .is-active the first time
      // they enter the viewport — that fades in a brighter overlay
      // gradient + runs a one-shot sweeping-dot animation across the
      // seam, giving each section transition a small "stitch" moment
      // instead of a hard cut. Reusing the existing reveal observer would
      // be tempting, but its `rootMargin` is tuned for content blocks
      // (40px shy of bottom). Seams want to fire a touch earlier — once
      // the user is clearly approaching the boundary, not once it has
      // fully entered the viewport.
      const seamObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            // Once activated, never re-trigger — re-running the sweep
            // every time the user scrolls back up would feel busy.
            seamObserver.unobserve(entry.target);
          }
        }
      }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
      const wireSeams = () => {
        document.querySelectorAll('.section-seam:not(.is-active)').forEach((el) => seamObserver.observe(el));
      };
      wireSeams();
      document.addEventListener('astro:page-load', wireSeams);

      // Scroll-velocity-driven flow energy.
      // Writes a 0..1 `--flow-energy` to every [data-flow] container based
      // on how fast the user is currently scrolling, with exponential decay
      // back to 0 at rest. CSS in global.css picks this up to brighten the
      // SystemFlow particles + a core energy ring — the diagram visibly
      // reacts to attention rather than looping on a fixed cadence.
      //
      // Polish-pass tuning (vs. original 0.45 / 0.18 / 0.94):
      //   burst cap   0.45 → 0.30  — single wheel tick contributes less,
      //                              so the visual no longer flares on
      //                              casual scrolling
      //   smoothing   0.18 → 0.12  — energy lerps slower toward target,
      //                              giving a flowing ramp instead of a
      //                              quick snap; reads as breath, not jitter
      //   decay       0.94 → 0.94  — kept; ~0.5s half-life still feels right
      //
      // One global rAF loop. Scroll handler is passive and only does
      // arithmetic; the rAF idles itself out (`frame = 0`) once both
      // target and energy decay below a threshold, so an idle page costs
      // zero per-frame work.
      if (!reduceMotion) {
        let flowLastY = window.scrollY;
        let flowLastT = performance.now();
        let flowTarget = 0;
        let flowEnergy = 0;
        let flowFrame = 0;

        const flowEls = () => document.querySelectorAll<HTMLElement>('[data-flow]');

        const flowTick = () => {
          flowFrame = 0;
          flowTarget *= 0.94;
          flowEnergy += (flowTarget - flowEnergy) * 0.12;

          const v = flowEnergy.toFixed(3);
          flowEls().forEach((el) => el.style.setProperty('--flow-energy', v));

          if (flowEnergy > 0.002 || flowTarget > 0.002) {
            flowFrame = requestAnimationFrame(flowTick);
          } else {
            // Park at exactly 0 so the CSS calc()s settle to baseline.
            flowEls().forEach((el) => el.style.setProperty('--flow-energy', '0'));
          }
        };

        window.addEventListener('scroll', () => {
          const now = performance.now();
          const y = window.scrollY;
          const dy = Math.abs(y - flowLastY);
          const dt = Math.max(1, now - flowLastT);
          const burst = Math.min(0.30, dy / dt / 5);
          flowTarget = Math.min(1, flowTarget + burst);
          flowLastY = y;
          flowLastT = now;
          if (!flowFrame) flowFrame = requestAnimationFrame(flowTick);
        }, { passive: true });
      }
    </script>
  </body>
</html>
